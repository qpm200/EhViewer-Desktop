<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Design theme identity & geometry tokens for Classic Material ("classic-material") -->
    <x:String x:Key="EhActiveUiThemeId">classic-material</x:String>
    <CornerRadius x:Key="EhThemeCardCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="EhThemeCardInnerLeftCornerRadius">5,0,0,5</CornerRadius>
    <CornerRadius x:Key="EhThemeFloatingCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="EhThemeNavItemCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="EhThemeButtonCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="EhThemeSearchBarCornerRadius">8</CornerRadius>
    <Thickness x:Key="EhThemeCardBorderThickness">1</Thickness>
    <x:Double x:Key="EhThemeDrawerExpandedWidth">256</x:Double>
    <x:Double x:Key="EhThemeDrawerCompactWidth">64</x:Double>
</ResourceDictionary>
