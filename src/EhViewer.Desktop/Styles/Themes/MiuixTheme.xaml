<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Design theme identity & geometry tokens for MIUIX / HyperOS ("miuix") -->
    <x:String x:Key="EhActiveUiThemeId">miuix</x:String>
    <CornerRadius x:Key="EhThemeCardCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="EhThemeCardInnerLeftCornerRadius">15,0,0,15</CornerRadius>
    <CornerRadius x:Key="EhThemeFloatingCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="EhThemeNavItemCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="EhThemeButtonCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="EhThemeSearchBarCornerRadius">22</CornerRadius>
    <Thickness x:Key="EhThemeCardBorderThickness">1</Thickness>
    <x:Double x:Key="EhThemeDrawerExpandedWidth">240</x:Double>
    <x:Double x:Key="EhThemeDrawerCompactWidth">76</x:Double>
</ResourceDictionary>
