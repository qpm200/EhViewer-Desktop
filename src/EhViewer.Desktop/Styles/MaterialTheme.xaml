    <!-- Shared Material Card Style -->
    <Style x:Key="EhMaterialCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource EhCardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource EhCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="theming:ThemeMetricsBinder.Role" Value="Card" />
