<Page
    x:Class="EhViewer.Desktop.Views.TopListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EhViewer.Desktop.Controls"
    xmlns:vm="using:EhViewer.Desktop.ViewModels"
    xmlns:views="using:EhViewer.Desktop.Views"
    Background="{StaticResource EhPageBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:MaterialToolbar
            Title="E-Hentai 排行榜"
            Subtitle="{x:Bind ViewModel.Headline, Mode=OneWay}">
            <controls:MaterialToolbar.RightActions>
                <Button
                    Style="{StaticResource EhToolbarIconButtonStyle}"
                    ToolTipService.ToolTip="刷新榜单"
                    Click="OnRefreshClick">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                </Button>
            </controls:MaterialToolbar.RightActions>
        </controls:MaterialToolbar>

        <!-- Category & TimeWindow Material Controls -->
        <Border
            Grid.Row="1"
            Background="{StaticResource EhCardSurfaceBrush}"
            BorderBrush="{StaticResource EhDividerBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,12">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        Header="榜单类别"
                        MinWidth="210"
                        ItemsSource="{x:Bind ViewModel.ListTypeNames}"
                        SelectedIndex="{x:Bind ViewModel.SelectedListType, Mode=TwoWay}" />

                    <ComboBox
                        Grid.Column="1"
                        Header="统计时段"
                        MinWidth="150"
                        ItemsSource="{x:Bind ViewModel.TimeWindowNamesSource}"
                        SelectedIndex="{x:Bind ViewModel.SelectedTimeWindow, Mode=TwoWay}" />
                </Grid>

                <ProgressBar
                    IsIndeterminate="True"
                    Visibility="{x:Bind views:UiHelpers.VisibleIf(ViewModel.IsLoading), Mode=OneWay}" />
                <InfoBar
                    Visibility="{x:Bind views:UiHelpers.VisibleIfNotEmpty(ViewModel.ErrorMessage), Mode=OneWay}"
                    IsOpen="{x:Bind HasError(ViewModel.ErrorMessage), Mode=OneWay}"
                    Severity="Error"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <Border
            Grid.Row="2"
            Margin="24"
            Padding="24"
            MaxWidth="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource EhMaterialCardStyle}"
            Visibility="{x:Bind views:UiHelpers.VisibleWhenEmpty(ViewModel.Rows.Count, ViewModel.IsLoading), Mode=OneWay}">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE9D2;" FontSize="32" Foreground="{StaticResource EhPrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock
                    Text="暂无排行榜条目"
                    FontSize="15"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Foreground="{StaticResource EhTextPrimaryBrush}" />
                <TextBlock
                    Text="可点击右上角刷新重新拉取当前榜单数据。"
                    FontSize="12.5"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Foreground="{StaticResource EhTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <ListView
            Grid.Row="2"
            Padding="16,10"
            ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="OnRowClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,4" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TopListRow">
                    <Border
                        Style="{StaticResource EhMaterialCardStyle}"
                        Padding="14,10"
                        Tag="{x:Bind}"
                        PointerPressed="OnRankCardPointerPressed">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Background="{x:Bind views:TopListPage.RankBrush(Rank)}"
                                CornerRadius="14"
                                Width="42"
                                Height="28"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind views:TopListPage.FormatRank(Rank)}"
                                    FontSize="12.5"
                                    FontWeight="Bold"
                                    Foreground="#FFFFFFFF"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind Label}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource EhTextPrimaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{x:Bind Href}"
                                    FontSize="11"
                                    Foreground="{StaticResource EhTextSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Border
                                Grid.Column="2"
                                Background="{StaticResource EhTagBackgroundBrush}"
                                BorderBrush="{StaticResource EhTagBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,3"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind Value}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource EhPrimaryBrush}" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
