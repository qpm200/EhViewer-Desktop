<Page
    x:Class="EhViewer.Desktop.Views.GalleryListScenePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EhViewer.Desktop.Controls"
    xmlns:theming="using:EhViewer.Desktop.Services.Theming"
    xmlns:views="using:EhViewer.Desktop.Views"
    xmlns:vm="using:EhViewer.Desktop.ViewModels"
    Background="{StaticResource EhPageBackgroundBrush}"
    PreviewKeyDown="OnPagePreviewKeyDown">

    <Page.Resources>
        <!-- Android item_gallery_list_new horizontal detailed card -->
        <DataTemplate x:Key="HorizontalGalleryCardTemplate" x:DataType="vm:GalleryItemViewModel">
            <Border
                Style="{StaticResource EhMaterialCardStyle}"
                Tag="{x:Bind}"
                PointerPressed="OnCardPointerPressed"
                PointerReleased="OnCardPointerReleased"
                PointerEntered="OnCardPointerEntered"
                PointerExited="OnCardPointerExited"
                PointerCaptureLost="OnCardPointerExited"
                Tapped="OnCardTapped"
                ContextRequested="OnCardContextRequested"
                Height="128"
                Margin="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Proportional Cover (FixedThumbNew) -->
                    <Border
                        Grid.Column="0"
                        Background="{StaticResource EhSubtleSurfaceBrush}"
                        theming:ThemeMetricsBinder.Role="CardInnerLeft"
                        CornerRadius="5,0,0,5">
                        <Grid>
                            <FontIcon
                                Glyph="&#xEB9F;"
                                FontSize="22"
                                Opacity="0.4"
                                Foreground="{StaticResource EhTextSecondaryBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <Border
                                x:Name="ThumbHost"
                                theming:ThemeMetricsBinder.Role="CardInnerLeft"
                                CornerRadius="5,0,0,5" />
                        </Grid>
                    </Border>

                    <!-- Right Metadata -->
                    <Grid Grid.Column="1" Padding="12,8,12,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top: 2-line Title & Uploader -->
                        <StackPanel Grid.Row="0" Spacing="2">
                            <TextBlock
                                Text="{x:Bind Title}"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource EhTextPrimaryBrush}"
                                TextWrapping="WrapWholeWords"
                                MaxLines="2"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{x:Bind Uploader}"
                                FontSize="12"
                                Foreground="{StaticResource EhTextSecondaryBrush}"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind views:UiHelpers.VisibleIfNotEmpty(Uploader)}" />
                        </StackPanel>

                        <!-- Middle/Bottom-Left: Stars + Rating + Category Pill -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,4,0,4">
                            <controls:SimpleRatingView Rating="{x:Bind Rating}" StarSize="12" />
                            <TextBlock
                                Text="{x:Bind RatingText}"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource EhTextSecondaryBrush}"
                                VerticalAlignment="Center" />
                            <Border
                                Background="{x:Bind views:UiHelpers.CategoryBrush(Info.Category)}"
                                CornerRadius="3"
                                Padding="6,1">
                                <TextBlock
                                    Text="{x:Bind CategoryName}"
                                    Foreground="#FFFFFFFF"
                                    FontSize="10"
                                    FontWeight="Bold" />
                            </Border>
                        </StackPanel>

                        <!-- Bottom-Right Metadata Badges: Downloaded / Favorited / SimpleLang / Pages / Posted -->
                        <Grid Grid.Row="2">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <FontIcon
                                    Glyph="&#xE896;"
                                    FontSize="12"
                                    Foreground="{StaticResource EhPrimaryBrush}"
                                    Visibility="{x:Bind views:UiHelpers.VisibleIf(IsDownloaded), Mode=OneWay}"
                                    ToolTipService.ToolTip="已下载" />
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="3"
                                    Visibility="{x:Bind views:UiHelpers.VisibleIf(IsFavorited)}">
                                    <FontIcon Glyph="&#xEB52;" FontSize="11" Foreground="#FFF44336" />
                                    <TextBlock
                                        Text="{x:Bind FavoriteBadgeText}"
                                        FontSize="10"
                                        Foreground="#FFF44336"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                                <Border
                                    Background="{StaticResource EhTagBackgroundBrush}"
                                    BorderBrush="{StaticResource EhTagBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="4,0"
                                    Visibility="{x:Bind views:UiHelpers.VisibleIf(HasSimpleLanguage)}">
                                    <TextBlock
                                        Text="{x:Bind SimpleLanguage}"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource EhPrimaryBrush}" />
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind ShortPagesText}"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource EhTextSecondaryBrush}" />
                                <TextBlock
                                    Text="{x:Bind Posted}"
                                    FontSize="11"
                                    Foreground="{StaticResource EhTextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Compact Grid Card alternative -->
        <DataTemplate x:Key="GridGalleryCardTemplate" x:DataType="vm:GalleryItemViewModel">
            <Border
                Style="{StaticResource EhMaterialCardStyle}"
                Tag="{x:Bind}"
                PointerPressed="OnCardPointerPressed"
                PointerReleased="OnCardPointerReleased"
                PointerEntered="OnCardPointerEntered"
                PointerExited="OnCardPointerExited"
                PointerCaptureLost="OnCardPointerExited"
                Tapped="OnCardTapped"
                ContextRequested="OnCardContextRequested"
                Margin="4">
                <Grid RowSpacing="6" Padding="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="240" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Background="{StaticResource EhSubtleSurfaceBrush}"
                        theming:ThemeMetricsBinder.Role="CardInner"
                        CornerRadius="5">
                        <Grid>
                            <FontIcon
                                Glyph="&#xEB9F;"
                                FontSize="26"
                                Opacity="0.4"
                                Foreground="{StaticResource EhTextSecondaryBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <Border
                                x:Name="ThumbHost"
                                theming:ThemeMetricsBinder.Role="CardInner"
                                CornerRadius="5" />
                            <Border
                                Background="{x:Bind views:UiHelpers.CategoryBrush(Info.Category)}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="6"
                                CornerRadius="3"
                                Padding="6,2">
                                <TextBlock Text="{x:Bind CategoryName}" Foreground="#FFFFFFFF" FontSize="10" FontWeight="Bold" />
                            </Border>
                            <Border
                                Background="#B3000000"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="6"
                                CornerRadius="3"
                                Padding="5,1"
                                Visibility="{x:Bind views:UiHelpers.VisibleIfNotEmpty(ShortPagesText)}">
                                <TextBlock Text="{x:Bind ShortPagesText}" Foreground="#FFFFFFFF" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock
                        Grid.Row="1"
                        Text="{x:Bind Title}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource EhTextPrimaryBrush}"
                        TextWrapping="WrapWholeWords"
                        MaxLines="2"
                        TextTrimming="CharacterEllipsis"
                        Height="36" />

                    <Grid Grid.Row="2">
                        <controls:SimpleRatingView Rating="{x:Bind Rating}" StarSize="11" HorizontalAlignment="Left" />
                        <TextBlock
                            Text="{x:Bind Posted}"
                            FontSize="10"
                            Foreground="{StaticResource EhTextSecondaryBrush}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <!-- Layered Main Scrollable List Content (padded top for floating SearchBar) -->
        <ScrollViewer
            x:Name="ListScroller"
            VerticalScrollBarVisibility="Auto"
            PointerPressed="OnListScrollerPointerPressed"
            ViewChanged="OnListScrollViewChanged">
            <StackPanel Padding="16,70,16,44" Spacing="10">

                <!-- Optional active filter summary bar -->
                <Grid x:Name="ListSummaryRow" Visibility="Collapsed" Margin="4,0">
                    <TextBlock
                        x:Name="ListSummaryText"
                        FontSize="12"
                        Foreground="{StaticResource EhTextSecondaryBrush}"
                        VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                        <Button x:Name="FirstPageBtn" Content="首页" Padding="8,3" FontSize="11" Click="OnFirstPageClick" />
                        <Button x:Name="PrevPageBtn" Content="上一页" Padding="8,3" FontSize="11" Click="OnPrevPageClick" />
                        <TextBlock x:Name="PageStatusBadge" FontSize="11" Foreground="{StaticResource EhTextSecondaryBrush}" VerticalAlignment="Center" />
                        <Button x:Name="NextPageBtn" Content="下一页" Padding="8,3" FontSize="11" Click="OnNextPageClick" />
                    </StackPanel>
                </Grid>

                <!-- Empty / Error Tip Panel -->
                <Border
                    x:Name="EmptyErrorPanel"
                    Visibility="Collapsed"
                    Style="{StaticResource EhMaterialCardStyle}"
                    MaxWidth="440"
                    HorizontalAlignment="Center"
                    Margin="0,60,0,0"
                    Padding="24">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE783;" FontSize="32" Foreground="{StaticResource EhPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock
                            x:Name="EmptyErrorText"
                            Text="当前列表为空"
                            Foreground="{StaticResource EhTextPrimaryBrush}"
                            FontSize="14"
                            TextWrapping="Wrap"
                            TextAlignment="Center" />
                        <Button
                            Content="重试 / 刷新"
                            Style="{StaticResource EhTealPrimaryButtonStyle}"
                            HorizontalAlignment="Center"
                            Click="OnRefreshClick" />
                    </StackPanel>
                </Border>

                <!-- Gallery Cards Repeater -->
                <ItemsRepeater
                    x:Name="GalleryRepeater"
                    ElementPrepared="OnGalleryElementPrepared"
                    ElementClearing="OnGalleryElementClearing">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            x:Name="RepeaterLayout"
                            MinItemWidth="460"
                            MinItemHeight="138"
                            MinRowSpacing="4"
                            MinColumnSpacing="4"
                            ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>

                <!-- Endless Scroll Footer -->
                <StackPanel x:Name="FooterPanel" HorizontalAlignment="Center" Spacing="8" Margin="0,12,0,0">
                    <ProgressRing x:Name="FooterBusyRing" IsActive="False" Width="26" Height="26" Visibility="Collapsed" />
                    <Button
                        x:Name="LoadMoreBtn"
                        Content="加载下一页"
                        Style="{StaticResource EhAccentFlatButtonStyle}"
                        Visibility="Collapsed"
                        Click="OnLoadMoreClick" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Android Floating SearchBar Card + Full-Width Rounded Suggestions Card -->
        <Grid VerticalAlignment="Top" Margin="20,12,20,0" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6">
                <Grid>
                    <Border
                        x:Name="SearchCardBorder"
                        Style="{StaticResource EhFloatingCardStyle}"
                        theming:ThemeMetricsBinder.Role="SearchBar"
                        Height="48"
                        Padding="8,0"
                        Translation="0,0,8">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Menu/Back or Magnifier icon -->
                            <Button
                                x:Name="SearchBarLeftBtn"
                                Grid.Column="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Width="38"
                                Height="38"
                                CornerRadius="19"
                                Padding="0"
                                ToolTipService.ToolTip="展开搜索选项 / 返回"
                                Click="OnSearchBarLeftClick">
                                <FontIcon x:Name="SearchBarLeftIcon" Glyph="&#xE721;" FontSize="15" Foreground="{StaticResource EhTextSecondaryBrush}" />
                            </Button>

                            <!-- Frameless Search Input -->
                            <TextBox
                                x:Name="SearchBox"
                                Grid.Column="1"
                                PlaceholderText="搜索关键词或点击右侧漏斗图标展开过滤..."
                                PlaceholderForeground="{StaticResource EhTextSecondaryBrush}"
                                Foreground="{StaticResource EhTextPrimaryBrush}"
                                FontSize="14"
                                BorderThickness="0"
                                Background="Transparent"
                                Padding="4,6"
                                FocusVisualPrimaryThickness="0"
                                VerticalAlignment="Center"
                                GotFocus="OnSearchBoxGotFocus"
                                LostFocus="OnSearchBoxLostFocus"
                                TextChanged="OnSearchTextChanged"
                                PreviewKeyDown="OnSearchBoxPreviewKeyDown">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                </TextBox.Resources>
                            </TextBox>

                            <!-- Right Toolbar Action Cluster -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Button
                                    x:Name="SearchLayoutToggleBtn"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Width="36"
                                    Height="36"
                                    CornerRadius="18"
                                    Padding="0"
                                    ToolTipService.ToolTip="高级搜索 / 分类 / 以图搜图面板"
                                    Click="OnToggleSearchLayoutClick">
                                    <FontIcon Glyph="&#xE71C;" FontSize="14" Foreground="{StaticResource EhPrimaryBrush}" />
                                </Button>

                                <Button
                                    x:Name="ViewModeBtn"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Width="36"
                                    Height="36"
                                    CornerRadius="18"
                                    Padding="0"
                                    ToolTipService.ToolTip="切换详细列表 / 网格视图"
                                    Click="OnToggleViewModeClick">
                                    <FontIcon x:Name="ViewModeIcon" Glyph="&#xF0E2;" FontSize="14" Foreground="{StaticResource EhTextSecondaryBrush}" />
                                </Button>

                                <Button
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Width="36"
                                    Height="36"
                                    CornerRadius="18"
                                    Padding="0"
                                    ToolTipService.ToolTip="打开快速搜索抽屉"
                                    Click="OnOpenQuickSearchDrawerClick">
                                    <FontIcon Glyph="&#xE728;" FontSize="14" Foreground="{StaticResource EhTextSecondaryBrush}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ProgressBar
                        x:Name="TopLoadingBar"
                        IsIndeterminate="True"
                        VerticalAlignment="Bottom"
                        Height="3"
                        Margin="18,0,18,0"
                        Visibility="Collapsed"
                        Foreground="{StaticResource EhPrimaryBrush}" />
                </Grid>

                <!-- Seamless Full-Width Rounded Search Suggestions Card -->
                <Border
                    x:Name="SuggestionsCard"
                    Style="{StaticResource EhFloatingCardStyle}"
                    Padding="6"
                    Translation="0,0,24"
                    Visibility="Collapsed"
                    PointerEntered="OnSuggestionsPointerEntered"
                    PointerExited="OnSuggestionsPointerExited">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <ListView
                        x:Name="SuggestionsList"
                        MaxHeight="280"
                        SelectionMode="Single"
                        IsItemClickEnabled="True"
                        SingleSelectionFollowsFocus="False"
                        ItemClick="OnSuggestionItemClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="10,7" />
                                <Setter Property="MinHeight" Value="36" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Grid Padding="0,1">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal" />
                                                        <VisualState x:Name="PointerOver">
                                                            <Storyboard>
                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SuggestBorder" Storyboard.TargetProperty="Background">
                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource EhHoverSurfaceBrush}" />
                                                                </ObjectAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Pressed">
                                                            <Storyboard>
                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SuggestBorder" Storyboard.TargetProperty="Background">
                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource EhPressedSurfaceBrush}" />
                                                                </ObjectAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Selected">
                                                            <Storyboard>
                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SuggestBorder" Storyboard.TargetProperty="Background">
                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource EhNavSelectedBackgroundBrush}" />
                                                                </ObjectAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="PointerOverSelected">
                                                            <Storyboard>
                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SuggestBorder" Storyboard.TargetProperty="Background">
                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource EhNavSelectedBackgroundBrush}" />
                                                                </ObjectAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="PressedSelected">
                                                            <Storyboard>
                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SuggestBorder" Storyboard.TargetProperty="Background">
                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource EhPressedSurfaceBrush}" />
                                                                </ObjectAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <Border
                                                    x:Name="SuggestBorder"
                                                    Background="Transparent"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter
                                                        Content="{TemplateBinding Content}"
                                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="views:SearchSuggestionEntry">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Grid.Column="0"
                                        Glyph="{x:Bind Glyph}"
                                        FontSize="13"
                                        Foreground="{StaticResource EhTextSecondaryBrush}"
                                        VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock
                                            Text="{x:Bind Text}"
                                            FontSize="13.5"
                                            Foreground="{StaticResource EhTextPrimaryBrush}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{x:Bind Subtitle}"
                                            Visibility="{x:Bind SubtitleVisibility}"
                                            FontSize="11.5"
                                            Foreground="{StaticResource EhTextSecondaryBrush}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="2"
                                        Background="{StaticResource EhSubtleSurfaceBrush}"
                                        BorderBrush="{StaticResource EhCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,1"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            Text="{x:Bind Badge}"
                                            FontSize="10.5"
                                            Foreground="{StaticResource EhTextSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>
        </Grid>

        <!-- SearchLayout Overlay (Android SearchLayout) -->
        <controls:SearchLayoutControl x:Name="SearchOverlay" />

        <!-- Expandable Corner FAB Menu (Android FabLayout) -->
        <controls:FabLayoutControl x:Name="CornerFab" />
    </Grid>
</Page>
