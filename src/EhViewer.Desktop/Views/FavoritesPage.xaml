<Page
    x:Class="EhViewer.Desktop.Views.FavoritesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EhViewer.Desktop.Controls"
    xmlns:vm="using:EhViewer.Desktop.ViewModels"
    xmlns:views="using:EhViewer.Desktop.Views"
    Background="{StaticResource EhPageBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:MaterialToolbar
            x:Name="Toolbar"
            Title="收藏夹"
            Subtitle="{x:Bind ViewModel.ResultCountText, Mode=OneWay}"
            ShowRightDrawerButton="True"
            RightDrawerRequested="OnRightDrawerRequested">
            <controls:MaterialToolbar.RightActions>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ToggleButton
                        x:Name="SelectionModeBtn"
                        IsChecked="{x:Bind ViewModel.IsSelectionMode, Mode=TwoWay}"
                        Checked="OnSelectionModeToggled"
                        Unchecked="OnSelectionModeToggled"
                        Style="{StaticResource EhToolbarToggleButtonStyle}"
                        ToolTipService.ToolTip="批量多选管理">
                        <FontIcon Glyph="&#xE762;" FontSize="16" />
                    </ToggleButton>
                    <Button
                        Style="{StaticResource EhToolbarIconButtonStyle}"
                        ToolTipService.ToolTip="刷新收藏夹"
                        Click="OnRefreshClick">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    </Button>
                </StackPanel>
            </controls:MaterialToolbar.RightActions>
        </controls:MaterialToolbar>

        <!-- Search, Sort & Quick Slot Strip -->
        <Border
            Grid.Row="1"
            Background="{StaticResource EhCardSurfaceBrush}"
            BorderBrush="{StaticResource EhDividerBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,10">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <AutoSuggestBox
                        x:Name="FavSearchBox"
                        PlaceholderText="在当前收藏夹搜索标题、上传者或标签..."
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.SearchKeyword, Mode=TwoWay}"
                        QuerySubmitted="OnSearchSubmitted" />

                    <ComboBox
                        x:Name="SortBox"
                        Grid.Column="1"
                        MinWidth="160"
                        SelectionChanged="OnSortSelectionChanged">
                        <ComboBoxItem Content="按收藏时间" Tag="f" />
                        <ComboBoxItem Content="按更新时间" Tag="p" />
                    </ComboBox>
                </Grid>

                <ScrollViewer
                    x:Name="SlotScroller"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    PointerWheelChanged="OnSlotScrollerPointerWheelChanged">
                    <ItemsRepeater
                        x:Name="SlotRepeater"
                        ItemsSource="{x:Bind ViewModel.Slots, Mode=OneWay}"
                        Margin="0,2,0,12"
                        ElementPrepared="OnSlotElementPrepared">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="6" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:FavoriteSlot">
                                <Button
                                    Padding="11,5"
                                    MinHeight="0"
                                    FontSize="12"
                                    CornerRadius="14"
                                    BorderThickness="1"
                                    Content="{x:Bind Display}"
                                    Tag="{x:Bind Index}"
                                    Click="OnSlotClick" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Status + Batch Action Strip -->
        <StackPanel Grid.Row="2" Padding="16,0,16,0" Spacing="6">
            <ProgressBar
                IsIndeterminate="True"
                Margin="0,6,0,0"
                Visibility="{x:Bind views:UiHelpers.VisibleIf(ViewModel.IsLoading), Mode=OneWay}" />
            <InfoBar
                Margin="0,6,0,0"
                Visibility="{x:Bind views:UiHelpers.VisibleIfNotEmpty(ViewModel.ErrorMessage), Mode=OneWay}"
                IsOpen="{x:Bind HasText(ViewModel.ErrorMessage), Mode=OneWay}"
                Severity="Error"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <InfoBar
                Margin="0,6,0,0"
                Visibility="{x:Bind views:UiHelpers.VisibleIfNotEmpty(ViewModel.InfoMessage), Mode=OneWay}"
                IsOpen="{x:Bind HasText(ViewModel.InfoMessage), Mode=OneWay}"
                Severity="Success"
                Message="{x:Bind ViewModel.InfoMessage, Mode=OneWay}" />

            <Border
                Margin="0,6,0,0"
                Style="{StaticResource EhMaterialCardStyle}"
                Padding="12,8"
                Visibility="{x:Bind views:UiHelpers.VisibleIf(ViewModel.IsSelectionMode), Mode=OneWay}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind FormatSelectedCount(ViewModel.SelectedCount), Mode=OneWay}"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource EhPrimaryBrush}" />
                        <Button Content="全选" Padding="8,4" FontSize="12" Click="OnSelectAllClick" />
                        <Button Content="反选" Padding="8,4" FontSize="12" Click="OnInvertSelectionClick" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <ComboBox x:Name="MoveTargetBox" MinWidth="138" PlaceholderText="移动到...">
                            <ComboBoxItem Content="本地收藏 (-2)" Tag="-2" />
                            <ComboBoxItem Content="Favorites 0" Tag="0" />
                            <ComboBoxItem Content="Favorites 1" Tag="1" />
                            <ComboBoxItem Content="Favorites 2" Tag="2" />
                            <ComboBoxItem Content="Favorites 3" Tag="3" />
                            <ComboBoxItem Content="Favorites 4" Tag="4" />
                            <ComboBoxItem Content="Favorites 5" Tag="5" />
                            <ComboBoxItem Content="Favorites 6" Tag="6" />
                            <ComboBoxItem Content="Favorites 7" Tag="7" />
                            <ComboBoxItem Content="Favorites 8" Tag="8" />
                            <ComboBoxItem Content="Favorites 9" Tag="9" />
                        </ComboBox>
                        <Button Content="移动" Padding="10,5" Style="{StaticResource EhTealPrimaryButtonStyle}" Click="OnMoveSelectedClick" />
                        <Button Content="下载" Padding="10,5" Click="OnDownloadSelectedClick" />
                        <Button Content="移出收藏" Padding="10,5" Click="OnDeleteSelectedClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Android Empty State -->
        <Border
            Grid.Row="3"
            Margin="24"
            Padding="24"
            MaxWidth="440"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource EhMaterialCardStyle}"
            Visibility="{x:Bind EmptyHintVisibility(ViewModel.Items.Count, ViewModel.IsLoading), Mode=OneWay}">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE734;" FontSize="32" Foreground="{StaticResource EhPrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock
                    Text="当前收藏夹暂无画廊"
                    FontSize="15"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Foreground="{StaticResource EhTextPrimaryBrush}" />
                <TextBlock
                    Text="可切换上方收藏夹槽位，或清除关键词筛选后再试。"
                    FontSize="12.5"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Foreground="{StaticResource EhTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Android item_gallery_list_new Horizontal Cards -->
        <ScrollViewer
            x:Name="FavScroller"
            Grid.Row="3"
            Padding="16,10"
            ViewChanged="OnFavScrollerViewChanged">
            <ItemsRepeater
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                ElementPrepared="OnGalleryElementPrepared"
                ElementClearing="OnGalleryElementClearing">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="10" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:GalleryItemViewModel">
                        <Border
                            Style="{StaticResource EhMaterialCardStyle}"
                            Height="140"
                            Padding="0"
                            Tag="{x:Bind}"
                            Tapped="OnGalleryTapped"
                            RightTapped="OnGalleryRightTapped"
                            PointerPressed="OnCardPointerPressed"
                            PointerReleased="OnCardPointerReleased"
                            PointerEntered="OnCardPointerEntered"
                            PointerExited="OnCardPointerExited"
                            PointerCaptureLost="OnCardPointerExited">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="98" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Background="{StaticResource EhSubtleSurfaceBrush}" CornerRadius="5,0,0,5">
                                    <Grid>
                                        <FontIcon Glyph="&#xEB9F;" FontSize="24" Foreground="{StaticResource EhTextSecondaryBrush}" />
                                        <Border
                                            x:Name="ThumbHost"
                                            CornerRadius="5,0,0,5" />
                                        <CheckBox
                                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                            Visibility="{x:Bind views:UiHelpers.VisibleIf(IsSelectionVisible), Mode=OneWay}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="6"
                                            MinWidth="24"
                                            Click="OnCardCheckboxClick" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Column="1" Padding="14,9">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Text="{x:Bind Title}"
                                        FontSize="14.5"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource EhTextPrimaryBrush}"
                                        TextWrapping="Wrap"
                                        MaxLines="2"
                                        TextTrimming="CharacterEllipsis" />

                                    <Grid Grid.Row="1" Margin="0,4,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Text="{x:Bind Uploader}"
                                            FontSize="12"
                                            Foreground="{StaticResource EhTextSecondaryBrush}"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind views:UiHelpers.VisibleIfNotEmpty(Uploader)}" />
                                        <Border
                                            Grid.Column="1"
                                            Background="{StaticResource EhTagBackgroundBrush}"
                                            BorderBrush="{StaticResource EhTagBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Padding="6,1"
                                            Visibility="{x:Bind views:UiHelpers.VisibleIf(HasSimpleLanguage)}">
                                            <TextBlock
                                                Text="{x:Bind SimpleLanguage}"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource EhPrimaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <controls:SimpleRatingView Rating="{x:Bind Rating}" StarSize="13" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Border
                                                Background="{x:Bind views:UiHelpers.CategoryBrush(Info.Category)}"
                                                CornerRadius="3"
                                                Padding="7,2">
                                                <TextBlock Text="{x:Bind CategoryName}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFFFF" />
                                            </Border>
                                            <Border
                                                Background="{StaticResource EhSubtleSurfaceBrush}"
                                                CornerRadius="3"
                                                Padding="6,2">
                                                <TextBlock Text="{x:Bind PagesText}" FontSize="11" Foreground="{StaticResource EhTextSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind Posted}"
                                            FontSize="11"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource EhTextSecondaryBrush}" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Bottom Pager -->
        <Border
            Grid.Row="4"
            Background="{StaticResource EhCardSurfaceBrush}"
            BorderBrush="{StaticResource EhDividerBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,8">
            <Grid>
                <TextBlock
                    Text="{x:Bind ViewModel.ResultCountText, Mode=OneWay}"
                    FontSize="12"
                    Foreground="{StaticResource EhTextSecondaryBrush}"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="上一页" IsEnabled="{x:Bind ViewModel.CanGoPrev, Mode=OneWay}" Click="OnPrevPageClick" />
                    <Button Style="{StaticResource EhTealPrimaryButtonStyle}" Content="加载更多" IsEnabled="{x:Bind ViewModel.HasMore, Mode=OneWay}" Click="OnLoadMoreClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
