<Page
    x:Class="EhViewer.Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EhViewer.Desktop.Controls"
    xmlns:theming="using:EhViewer.Desktop.Services.Theming"
    xmlns:views="using:EhViewer.Desktop.Views"
    Background="{StaticResource EhPageBackgroundBrush}">

    <Page.Resources>
        <Style x:Key="EhPrefRowDividerStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{StaticResource EhDividerBrush}" />
        </Style>
        <Style x:Key="EhPrefRowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource EhTextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="EhPrefRowCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource EhTextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="EhCompactToggleStyle" TargetType="ToggleSwitch">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:MaterialToolbar
            Title="应用设置"
            Subtitle="偏好分类 · 所有修改实时保存并立即生效">
            <controls:MaterialToolbar.RightActions>
                <Button
                    Style="{StaticResource EhToolbarIconButtonStyle}"
                    ToolTipService.ToolTip="重新载入设置"
                    Click="OnReloadClick">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                </Button>
            </controls:MaterialToolbar.RightActions>
        </controls:MaterialToolbar>

        <!-- Android Preference Headers (Left Rail) + Active Preference Fragment (Right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Background="{StaticResource EhCardSurfaceBrush}"
                BorderBrush="{StaticResource EhDividerBrush}"
                BorderThickness="0,0,1,0"
                Padding="10,14">
                <StackPanel Spacing="6">
                    <TextBlock
                        Text="设置分组"
                        FontSize="11.5"
                        FontWeight="SemiBold"
                        Margin="10,0,0,6"
                        Foreground="{StaticResource EhTextSecondaryBrush}" />

                    <Button x:Name="NavGroupEhBtn" Style="{StaticResource EhNavRowButtonStyle}" Padding="12,10" Click="OnSelectGroupEh">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{StaticResource EhPrimaryBrush}" />
                            <StackPanel>
                                <TextBlock Text="EH 站点与同步" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource EhTextPrimaryBrush}" />
                                <TextBlock Text="表里站 · 列表 · uconfig" FontSize="11" Foreground="{StaticResource EhTextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavGroupReadBtn" Style="{StaticResource EhNavRowButtonStyle}" Padding="12,10" Click="OnSelectGroupRead">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE736;" FontSize="16" Foreground="{StaticResource EhPrimaryBrush}" />
                            <StackPanel>
                                <TextBlock Text="阅读体验" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource EhTextPrimaryBrush}" />
                                <TextBlock Text="方向 · 缩放 · 解码与全屏" FontSize="11" Foreground="{StaticResource EhTextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavGroupDownloadBtn" Style="{StaticResource EhNavRowButtonStyle}" Padding="12,10" Click="OnSelectGroupDownload">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE896;" FontSize="16" Foreground="{StaticResource EhPrimaryBrush}" />
                            <StackPanel>
                                <TextBlock Text="下载与缓存" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource EhTextPrimaryBrush}" />
                                <TextBlock Text="目录 · 并发 · 内存与磁盘配额" FontSize="11" Foreground="{StaticResource EhTextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavGroupPrivacyBtn" Style="{StaticResource EhNavRowButtonStyle}" Padding="12,10" Click="OnSelectGroupPrivacy">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{StaticResource EhPrimaryBrush}" />
                            <StackPanel>
                                <TextBlock Text="隐私与安全" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource EhTextPrimaryBrush}" />
                                <TextBlock Text="PIN · Windows Hello · 黑名单与过滤" FontSize="11" Foreground="{StaticResource EhTextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavGroupAdvancedBtn" Style="{StaticResource EhNavRowButtonStyle}" Padding="12,10" Click="OnSelectGroupAdvanced">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE90F;" FontSize="16" Foreground="{StaticResource EhPrimaryBrush}" />
                            <StackPanel>
                                <TextBlock Text="外观、网络与高级" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource EhTextPrimaryBrush}" />
                                <TextBlock Text="主题 · 代理 · Hosts · 数据维护" FontSize="11" Foreground="{StaticResource EhTextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavGroupAboutBtn" Style="{StaticResource EhNavRowButtonStyle}" Padding="12,10" Click="OnSelectGroupAbout">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{StaticResource EhPrimaryBrush}" />
                            <StackPanel>
                                <TextBlock Text="更新与关于" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource EhTextPrimaryBrush}" />
                                <TextBlock Text="检查更新 · 开源许可 · 配置目录" FontSize="11" Foreground="{StaticResource EhTextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid Padding="24,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Group 0: EH 站点与同步 -->
                    <StackPanel x:Name="GroupEhPanel" Spacing="16">
                        <Border Style="{StaticResource EhMaterialCardStyle}" Padding="20,16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="站点与列表显示" Style="{StaticResource EhSettingsCategoryTitleStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="使用里站 (exhentai.org)" Style="{StaticResource EhPrefRowTitleStyle}" />
                                        <TextBlock Text="需要已登录且具备有效 igneous 凭证" Style="{StaticResource EhPrefRowCaptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource EhCompactToggleStyle}" IsOn="{x:Bind ViewModel.UseExHentai, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="显示日文标题" Style="{StaticResource EhPrefRowTitleStyle}" />
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource EhCompactToggleStyle}" IsOn="{x:Bind ViewModel.ShowJpnTitle, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="在列表卡片显示画廊页数" Style="{StaticResource EhPrefRowTitleStyle}" />
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource EhCompactToggleStyle}" IsOn="{x:Bind ViewModel.ShowGalleryPages, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="启用鼠标悬停画廊预览浮窗" Style="{StaticResource EhPrefRowTitleStyle}" />
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource EhCompactToggleStyle}" IsOn="{x:Bind ViewModel.ShowHoverPreview, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="列表每页条目数" Style="{StaticResource EhPrefRowTitleStyle}" />
                                    <ComboBox Grid.Column="1" Width="220" ItemsSource="{x:Bind ViewModel.ListPageSizeNames}" SelectedIndex="{x:Bind ViewModel.ListPageSizeIndex, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="缩略图分辨率覆盖" Style="{StaticResource EhPrefRowTitleStyle}" />
                                    <ComboBox Grid.Column="1" Width="220" ItemsSource="{x:Bind ViewModel.ThumbResolutionNames}" SelectedIndex="{x:Bind ViewModel.ThumbResolutionIndex, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="修复旧版缩略图主机 URL" Style="{StaticResource EhPrefRowTitleStyle}" />
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource EhCompactToggleStyle}" IsOn="{x:Bind ViewModel.FixThumbUrl, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="站点原图缩放规格 (uconfig)" Style="{StaticResource EhPrefRowTitleStyle}" />
                                    <ComboBox Grid.Column="1" Width="220" ItemsSource="{x:Bind ViewModel.ImageResolutionNames}" SelectedIndex="{x:Bind ViewModel.ImageResolutionIndex, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="保存解析失败页面" Style="{StaticResource EhPrefRowTitleStyle}" />
                                        <TextBlock Text="解析 HTML 出错时写入日志目录以便排查" Style="{StaticResource EhPrefRowCaptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource EhCompactToggleStyle}" IsOn="{x:Bind ViewModel.SaveParseErrorBody, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource EhMaterialCardStyle}" Padding="20,16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="E-Hentai 站点偏好同步 (uconfig)" Style="{StaticResource EhSettingsCategoryTitleStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="排除语言过滤 (17×3)" Style="{StaticResource EhPrefRowTitleStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.ExcludedLanguagesSummary, Mode=OneWay}" Style="{StaticResource EhPrefRowCaptionStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="配置排除语言" Click="OnEditExcludedLanguagesClick" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="排除标签命名空间 (8 项)" Style="{StaticResource EhPrefRowTitleStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.ExcludedNamespacesSummary, Mode=OneWay}" Style="{StaticResource EhPrefRowCaptionStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="配置排除命名空间" Click="OnEditExcludedNamespacesClick" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="收藏夹排序方式" Style="{StaticResource EhPrefRowTitleStyle}" />
                                    <ComboBox Grid.Column="1" Width="220" ItemsSource="{x:Bind ViewModel.FavoritesSortNames}" SelectedIndex="{x:Bind ViewModel.FavoritesSortIndex, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="画廊评论排序方式" Style="{StaticResource EhPrefRowTitleStyle}" />
                                    <ComboBox Grid.Column="1" Width="220" ItemsSource="{x:Bind ViewModel.CommentsSortNames}" SelectedIndex="{x:Bind ViewModel.CommentsSortIndex, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="首页启用「热门 (WhatsHot)」区块" Style="{StaticResource EhPrefRowTitleStyle}" />
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource EhCompactToggleStyle}" IsOn="{x:Bind ViewModel.EnablePopularOnHome, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                    <Button Content="写入本地 uconfig Cookie" Click="OnApplyUConfigCookieClick" />
                                    <Button Content="从 Cookie 回填" Click="OnPullUConfigCookieClick" />
                                    <Button Style="{StaticResource EhTealPrimaryButtonStyle}" Content="在线同步 uconfig.php" Click="OnSyncUConfigOnlineClick" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.UConfigStatusMessage, Mode=OneWay}" Visibility="{x:Bind TextToVisibility(ViewModel.UConfigStatusMessage), Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource EhTextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Group 1: 阅读体验 -->
                    <StackPanel x:Name="GroupReadPanel" x:Load="False" Spacing="16" Visibility="Collapsed">
                        <Border Style="{StaticResource EhMaterialCardStyle}" Padding="20,16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="阅读器默认设置" Style="{StaticResource EhSettingsCategoryTitleStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="预加载页数 (1-10)" Style="{StaticResource EhPrefRowTitleStyle}" />
                                    <NumberBox Grid.Column="1" Width="160" Minimum="1" Maximum="10" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.PreloadCount, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="默认阅读方向" Style="{StaticResource EhPrefRowTitleStyle}" />
                                    <ComboBox Grid.Column="1" Width="220" ItemsSource="{x:Bind ViewModel.ReaderLayoutNames}" SelectedIndex="{x:Bind ViewModel.DefaultReaderLayoutIndex, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="默认缩放模式" Style="{StaticResource EhPrefRowTitleStyle}" />
                                    <ComboBox Grid.Column="1" Width="220" ItemsSource="{x:Bind ViewModel.ReaderScaleNames}" SelectedIndex="{x:Bind ViewModel.DefaultReaderScaleIndex, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="默认最大解码边长" Style="{StaticResource EhPrefRowTitleStyle}" />
                                    <ComboBox Grid.Column="1" Width="220" ItemsSource="{x:Bind ViewModel.MaxDecodeEdgeNames}" SelectedIndex="{x:Bind ViewModel.MaxDecodeEdgeIndex, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="默认开启双页并排阅读" Style="{StaticResource EhPrefRowTitleStyle}" />
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource EhCompactToggleStyle}" IsOn="{x:Bind ViewModel.DualPageMode, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="双页模式下封面单页显示" Style="{StaticResource EhPrefRowTitleStyle}" />
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource EhCompactToggleStyle}" IsOn="{x:Bind ViewModel.DualPageFirstAlone, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="默认使用纵向连续滚动" Style="{StaticResource EhPrefRowTitleStyle}" />
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource EhCompactToggleStyle}" IsOn="{x:Bind ViewModel.ContinuousScroll, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="强制解码转码至 sRGB" Style="{StaticResource EhPrefRowTitleStyle}" />
                                        <TextBlock Text="避免广色域屏幕出现色彩过饱和" Style="{StaticResource EhPrefRowCaptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource EhCompactToggleStyle}" IsOn="{x:Bind ViewModel.ForceSrgb, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="阅读画面显示页码与时钟角标" Style="{StaticResource EhPrefRowTitleStyle}" />
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource EhCompactToggleStyle}" IsOn="{x:Bind ViewModel.ShowPageNumber, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="阅读时保持屏幕唤醒" Style="{StaticResource EhPrefRowTitleStyle}" />
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource EhCompactToggleStyle}" IsOn="{x:Bind ViewModel.KeepScreenOn, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="开启滚轮边缘自动翻页" Style="{StaticResource EhPrefRowTitleStyle}" />
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource EhCompactToggleStyle}" IsOn="{x:Bind ViewModel.PageTurnByWheel, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="全屏阅读时自动隐藏控制栏" Style="{StaticResource EhPrefRowTitleStyle}" />
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource EhCompactToggleStyle}" IsOn="{x:Bind ViewModel.HideReaderChromeInFullscreen, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource EhMaterialCardStyle}" Padding="20,16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="生肉识字与防拒答翻译" Style="{StaticResource EhSettingsCategoryTitleStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="OCR 识别语言（按需本地识字，快捷键 O）" Style="{StaticResource EhPrefRowTitleStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.OcrLanguagePackStatus, Mode=OneWay}" Style="{StaticResource EhPrefRowCaptionStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="260" ItemsSource="{x:Bind ViewModel.OcrLanguageNames}" SelectedIndex="{x:Bind ViewModel.ReaderOcrLanguageIndex, Mode=TwoWay}" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="打开系统语言设置安装 OCR" Click="OnOpenWindowsLanguageSettingsClick" />
                                    <Button Content="刷新 OCR 检测" Click="OnRefreshOcrStatusClick" />
                                </StackPanel>

                                <StackPanel Spacing="8" Padding="12" CornerRadius="8" Background="#1000BFA5">
                                    <TextBlock Text="两阶段漫画气泡识别引擎（RT-DETR 气泡定位 + Manga-OCR CPT-v2 高精度日漫识字）" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.MangaOcrModelStatus, Mode=OneWay}" Style="{StaticResource EhPrefRowCaptionStyle}" TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="下载使用国内镜像 (hf-mirror.com)" Style="{StaticResource EhPrefRowTitleStyle}" />
                                        <ToggleSwitch Grid.Column="1" Style="{StaticResource EhCompactToggleStyle}" IsOn="{x:Bind ViewModel.UseHfMirrorForModelDownload, Mode=TwoWay}" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="一键下载 / 升级漫画 OCR 模型 (~161 MB)" Click="OnDownloadMangaOcrModelsClick" />
                                        <Button Content="取消下载" Click="OnCancelModelDownloadClick" Visibility="{x:Bind ViewModel.IsModelDownloading, Mode=OneWay}" />
                                    </StackPanel>
                                    <ProgressBar
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{x:Bind ViewModel.LocalModelDownloadProgress, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsModelDownloading, Mode=OneWay}" />
                                </StackPanel>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="翻译引擎路由" Style="{StaticResource EhPrefRowTitleStyle}" />
                                        <TextBlock Text="支持传统直译、DeepSeek AI（低推理单页连续上下文）、本地 Sakura-7B 与自定义接口" Style="{StaticResource EhPrefRowCaptionStyle}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="260" ItemsSource="{x:Bind ViewModel.TranslationProviderNames}" SelectedIndex="{x:Bind ViewModel.ReaderTranslationProviderIndex, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="拒答/内容过滤自动回退" Style="{StaticResource EhPrefRowTitleStyle}" />
                                        <TextBlock Text="当主引擎触发内容审查拒答或连接失败时自动切换至本地模型/传统直译" Style="{StaticResource EhPrefRowCaptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource EhCompactToggleStyle}" IsOn="{x:Bind ViewModel.ReaderTranslationAutoFallback, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="内嵌译文视觉样式" Style="{StaticResource EhPrefRowTitleStyle}" />
                                        <TextBlock Text="「填底嵌字」自动采样气泡底色与字色覆盖日文原文；「紧凑角标」保留原文叠加小标签" Style="{StaticResource EhPrefRowCaptionStyle}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="260" ItemsSource="{x:Bind ViewModel.InlineTranslationStyleNames}" SelectedIndex="{x:Bind ViewModel.ReaderInlineTranslationStyleIndex, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="阅读器默认开启自动连译" Style="{StaticResource EhPrefRowTitleStyle}" />
                                        <TextBlock Text="在阅读器开启识字后，翻页或纵向滚动停顿时自动检测并内嵌翻译当前页全部气泡" Style="{StaticResource EhPrefRowCaptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource EhCompactToggleStyle}" IsOn="{x:Bind ViewModel.ReaderAutoTranslateOnPageTurn, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Style="{StaticResource EhPrefRowDividerStyle}" />

                                <StackPanel Spacing="6">
                                    <TextBox
