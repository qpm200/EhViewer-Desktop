<Page
    x:Class="EhViewer.Desktop.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EhViewer.Desktop.Controls"
    xmlns:vm="using:EhViewer.Desktop.ViewModels"
    xmlns:views="using:EhViewer.Desktop.Views"
    Background="{StaticResource EhPageBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:MaterialToolbar
            Title="账号与站点中心"
            Subtitle="{x:Bind ViewModel.DisplayName, Mode=OneWay}">
            <controls:MaterialToolbar.RightActions>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button
                        Style="{StaticResource EhToolbarIconButtonStyle}"
                        ToolTipService.ToolTip="刷新档案"
                        IsEnabled="{x:Bind IsNotBusy(ViewModel.IsBusy), Mode=OneWay}"
                        Click="OnRefreshProfileClick">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    </Button>
                    <Button
                        Style="{StaticResource EhToolbarIconButtonStyle}"
                        ToolTipService.ToolTip="退出登录"
                        Click="OnSignOutClick">
                        <FontIcon Glyph="&#xF3B1;" FontSize="16" />
                    </Button>
                </StackPanel>
            </controls:MaterialToolbar.RightActions>
        </controls:MaterialToolbar>

        <ScrollViewer Grid.Row="1" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="16">

                <ProgressBar
                    IsIndeterminate="True"
                    Visibility="{x:Bind BoolToVisibility(ViewModel.IsBusy), Mode=OneWay}" />

                <InfoBar
                    Visibility="{x:Bind views:UiHelpers.VisibleIfNotEmpty(ViewModel.ErrorMessage), Mode=OneWay}"
                    IsOpen="{x:Bind HasError(ViewModel.ErrorMessage), Mode=OneWay}"
                    Severity="Error"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    IsClosable="False" />

                <!-- Account Summary Strip -->
                <Border Style="{StaticResource EhMaterialCardStyle}" Padding="16">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="48"
                            Height="48"
                            CornerRadius="24"
                            Background="{StaticResource EhPrimaryBrush}">
                            <FontIcon Glyph="&#xE77B;" FontSize="22" Foreground="#FFFFFFFF" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                Text="{x:Bind views:LoginPage.FormatDisplayName(ViewModel.DisplayName), Mode=OneWay}"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource EhTextPrimaryBrush}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                FontSize="12.5"
                                Foreground="{StaticResource EhPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button
                                Content="刷新档案"
                                IsEnabled="{x:Bind IsNotBusy(ViewModel.IsBusy), Mode=OneWay}"
                                Click="OnRefreshProfileClick" />
                            <Button Content="退出登录" Click="OnSignOutClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Segmented Material Auth Card (Password | Cookie | WebView2 & uconfig) -->
                <Border Style="{StaticResource EhMaterialCardStyle}" Padding="16">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="AuthTabPasswordBtn"
                                Style="{StaticResource EhTealPrimaryButtonStyle}"
                                Content="账号密码登录"
                                Click="OnSelectPasswordAuthClick" />
                            <Button
                                x:Name="AuthTabCookieBtn"
                                Content="Cookie 登录"
                                Click="OnSelectCookieAuthClick" />
                            <Button
                                x:Name="AuthTabWebViewBtn"
                                Content="WebView2 网页与 uconfig"
                                Click="OnSelectWebViewAuthClick" />
                        </StackPanel>

                        <StackPanel x:Name="AuthPasswordPanel" Spacing="10">
                            <TextBox
                                Header="用户名"
                                PlaceholderText="E-Hentai 论坛用户名"
                                Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <PasswordBox
                                Header="密码"
                                PlaceholderText="输入密码"
                                Password="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Style="{StaticResource EhTealPrimaryButtonStyle}"
                                Content="登录账号"
                                IsEnabled="{x:Bind IsNotBusy(ViewModel.IsBusy), Mode=OneWay}"
                                Click="OnPasswordSignInClick" />
                        </StackPanel>

                        <StackPanel x:Name="AuthCookiePanel" Spacing="10" Visibility="Collapsed">
                            <TextBox
                                Header="ipb_member_id"
                                PlaceholderText="必填，账号数字 ID"
                                Text="{x:Bind ViewModel.IpbMemberId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Header="ipb_pass_hash"
                                PlaceholderText="必填，会话哈希值"
                                Text="{x:Bind ViewModel.IpbPassHash, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Header="igneous"
                                PlaceholderText="可选，访问里站（ExHentai）时填写"
                                Text="{x:Bind ViewModel.Igneous, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Style="{StaticResource EhTealPrimaryButtonStyle}"
                                Content="使用 Cookie 登录"
                                IsEnabled="{x:Bind IsNotBusy(ViewModel.IsBusy), Mode=OneWay}"
                                Click="OnCookieSignInClick" />
                        </StackPanel>

                        <StackPanel x:Name="AuthWebViewPanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock
                                Text="当登录触发人机校验或需在线修改 uconfig.php 时，可开启内嵌 WebView2 会话，确认后自动采集站点 Cookie。"
                                FontSize="12.5"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource EhTextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Style="{StaticResource EhTealPrimaryButtonStyle}"
                                    Content="WebView2 网页登录"
                                    IsEnabled="{x:Bind IsNotBusy(ViewModel.IsBusy), Mode=OneWay}"
                                    Click="OnWebViewLoginClick" />
                                <Button
                                    Content="WebView2 打开 uconfig.php"
                                    IsEnabled="{x:Bind IsNotBusy(ViewModel.IsBusy), Mode=OneWay}"
                                    Click="OnWebViewUConfigClick" />
                                <Button
                                    Content="在线同步 uconfig"
                                    IsEnabled="{x:Bind IsNotBusy(ViewModel.IsBusy), Mode=OneWay}"
                                    Click="OnSyncUConfigOnlineClick" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Image Limits & GP (home.php) -->
                <Border Style="{StaticResource EhMaterialCardStyle}" Padding="16">
                    <StackPanel Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="账户图片配额与 GP 统计（home.php）"
                                FontSize="15"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource EhTextPrimaryBrush}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button
                                    Content="查询配额"
                                    IsEnabled="{x:Bind IsNotBusy(ViewModel.IsBusy), Mode=OneWay}"
                                    Click="OnLoadQuotaClick" />
                                <Button
                                    Content="使用 GP 重置配额"
                                    IsEnabled="{x:Bind IsNotBusy(ViewModel.IsBusy), Mode=OneWay}"
                                    Click="OnResetLimitClick" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Text="{x:Bind ViewModel.HomeQuotaText, Mode=OneWay}"
                            Visibility="{x:Bind TextToVisibility(ViewModel.HomeQuotaText), Mode=OneWay}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True"
                            Foreground="{StaticResource EhTextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- E-Hentai News (news.php) -->
                <Border Style="{StaticResource EhMaterialCardStyle}" Padding="16">
                    <StackPanel Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="E-Hentai 站点新闻与公告（news.php）"
                                FontSize="15"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource EhTextPrimaryBrush}" />
                            <Button
                                Grid.Column="1"
                                Content="获取最新新闻"
                                IsEnabled="{x:Bind IsNotBusy(ViewModel.IsBusy), Mode=OneWay}"
                                Click="OnLoadNewsClick" />
                        </Grid>

                        <InfoBar
                            Visibility="{x:Bind views:UiHelpers.VisibleIfNotEmpty(ViewModel.EventPaneText), Mode=OneWay}"
                            IsOpen="{x:Bind HasError(ViewModel.EventPaneText), Mode=OneWay}"
                            Severity="Informational"
                            Title="站点事件提醒"
                            IsClosable="False"
                            Message="{x:Bind ViewModel.EventPaneText, Mode=OneWay}" />

                        <TextBlock
                            Text="{x:Bind ViewModel.EhNewsText, Mode=OneWay}"
                            Visibility="{x:Bind TextToVisibility(ViewModel.EhNewsText), Mode=OneWay}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True"
                            Foreground="{StaticResource EhTextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- MyTags Manager -->
                <Border Style="{StaticResource EhMaterialCardStyle}" Padding="16">
                    <StackPanel Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="个人标签管理（MyTags）"
                                FontSize="15"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource EhTextPrimaryBrush}" />
                            <Button
                                Grid.Column="1"
                                Content="加载 MyTags"
                                IsEnabled="{x:Bind IsNotBusy(ViewModel.IsBusy), Mode=OneWay}"
                                Click="OnLoadWatchedTagsClick" />
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                PlaceholderText="标签名（例：language:chinese）"
                                Text="{x:Bind ViewModel.NewTagName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Grid.Column="1" Content="关注" IsChecked="{x:Bind ViewModel.NewTagWatched, Mode=TwoWay}" />
                            <CheckBox Grid.Column="2" Content="隐藏" IsChecked="{x:Bind ViewModel.NewTagHidden, Mode=TwoWay}" />
                            <TextBox Grid.Column="3" PlaceholderText="#颜色" Text="{x:Bind ViewModel.NewTagColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="4"
                                Style="{StaticResource EhTealPrimaryButtonStyle}"
                                Content="添加"
                                IsEnabled="{x:Bind IsNotBusy(ViewModel.IsBusy), Mode=OneWay}"
                                Click="OnAddWatchedTagClick" />
                        </Grid>

                        <ListView MaxHeight="280" SelectionMode="None" ItemsSource="{x:Bind ViewModel.WatchedTags, Mode=OneWay}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:WatchedTagRow">
                                    <Grid ColumnSpacing="8" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" Foreground="{StaticResource EhTextPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind DetailText}" FontSize="12" Foreground="{StaticResource EhTextSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="删除" Tag="{x:Bind}" Click="OnDeleteWatchedTagClick" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Subtle DPAPI Security Notice Footer -->
                <Border
                    Background="{StaticResource EhSubtleSurfaceBrush}"
                    BorderBrush="{StaticResource EhCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE72E;" FontSize="14" Foreground="{StaticResource EhPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock
                            Text="DPAPI 凭据安全：Cookie 与账号会话均通过 Windows DPAPI 加密持久化于本机，绝不落盘存储明文密码。"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource EhTextSecondaryBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
