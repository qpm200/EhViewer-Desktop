<Page
    x:Class="EhViewer.Desktop.Views.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EhViewer.Desktop.ViewModels"
    xmlns:views="using:EhViewer.Desktop.Views"
    Background="Black"
    KeyDown="OnKeyDown"
    Loaded="OnPageLoaded"
    Unloaded="OnPageUnloaded"
    IsTabStop="True">

    <Page.Resources>
        <Style x:Key="ReaderHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1EFFFFFF" />
            <Setter Property="BorderBrush" Value="#24FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#34FFFFFF" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#48FFFFFF" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0.4" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReaderHeaderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#1EFFFFFF" />
            <Setter Property="BorderBrush" Value="#24FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#34FFFFFF" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#48FFFFFF" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FF009688" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FF26A69A" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FF26A69A" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FF4DB6AC" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FF00796B" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Full-height reading viewport with Android 3x3 Tap Zones + Floating Header/Footer HUD -->
        <Grid
            x:Name="PageSurfaceGrid"
            Background="Black"
            Tapped="OnSurfaceTapped"
            DoubleTapped="OnSurfaceDoubleTapped"
            PointerPressed="OnSurfacePointerPressed"
            PointerMoved="OnSurfacePointerMoved"
            PointerReleased="OnSurfacePointerReleased"
            PointerCaptureLost="OnSurfacePointerCaptureLost"
            SizeChanged="OnSurfaceSizeChanged">

            <!-- 1. Single page surface -->
            <ScrollViewer
                x:Name="PageScroller"
                Visibility="{x:Bind ViewModel.ShowSingleSurface, Mode=OneWay}"
                ZoomMode="Enabled"
                MinZoomFactor="0.5"
                MaxZoomFactor="4.0"
                HorizontalScrollMode="Auto"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto"
                VerticalScrollBarVisibility="Auto"
                ViewChanged="OnPageScrollerViewChanged">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image
                        x:Name="PageImage"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        SizeChanged="OnOcrImageSizeChanged"
                        Source="{x:Bind ViewModel.CurrentImage, Mode=OneWay}" />
                    <Canvas
                        x:Name="SingleOcrCanvas"
                        IsHitTestVisible="True"
                        PointerPressed="OnOcrCanvasPointerPressed"
                        PointerMoved="OnOcrCanvasPointerMoved"
                        PointerReleased="OnOcrCanvasPointerReleased"
                        PointerCaptureLost="OnOcrCanvasPointerCaptureLost" />
                </Grid>
            </ScrollViewer>

            <!-- 2. Dual-page side-by-side surface -->
            <ScrollViewer
                x:Name="DualScroller"
                Visibility="{x:Bind ViewModel.ShowDualSurface, Mode=OneWay}"
                ZoomMode="Enabled"
                MinZoomFactor="0.5"
                MaxZoomFactor="4.0"
                HorizontalScrollMode="Auto"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto"
                VerticalScrollBarVisibility="Auto"
                ViewChanged="OnPageScrollerViewChanged">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Image
                            x:Name="LeftPageImage"
                            Stretch="Uniform"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            SizeChanged="OnOcrImageSizeChanged"
                            Source="{x:Bind ViewModel.LeftPageImage, Mode=OneWay}" />
                        <Canvas
                            x:Name="LeftOcrCanvas"
                            IsHitTestVisible="True"
                            PointerPressed="OnOcrCanvasPointerPressed"
                            PointerMoved="OnOcrCanvasPointerMoved"
                            PointerReleased="OnOcrCanvasPointerReleased"
                            PointerCaptureLost="OnOcrCanvasPointerCaptureLost" />
                    </Grid>
                    <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Image
                            x:Name="RightPageImage"
                            Stretch="Uniform"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            SizeChanged="OnOcrImageSizeChanged"
                            Source="{x:Bind ViewModel.RightPageImage, Mode=OneWay}" />
                        <Canvas
                            x:Name="RightOcrCanvas"
                            IsHitTestVisible="True"
                            PointerPressed="OnOcrCanvasPointerPressed"
                            PointerMoved="OnOcrCanvasPointerMoved"
                            PointerReleased="OnOcrCanvasPointerReleased"
                            PointerCaptureLost="OnOcrCanvasPointerCaptureLost" />
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- 3. Continuous vertical strip surface -->
            <ListView
                x:Name="StripListView"
                Visibility="{x:Bind ViewModel.IsContinuousVertical, Mode=OneWay}"
                SelectionMode="None"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.StripPages, Mode=OneWay}"
                ContainerContentChanging="OnStripContainerContentChanging">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:StripPageItem">
                        <StackPanel Spacing="4" HorizontalAlignment="Center" Margin="0,4">
                            <Border MinHeight="320" MinWidth="420" Background="#141414" CornerRadius="6" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                <Grid>
                                    <StackPanel
                                        Spacing="8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="240"
                                        Visibility="{x:Bind views:UiHelpers.CollapsedIf(IsLoaded), Mode=OneWay}">
                                        <TextBlock
                                            Text="{x:Bind Label}"
                                            Foreground="#E6FFFFFF"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            HorizontalAlignment="Center" />
                                        <TextBlock
                                            Text="{x:Bind StatusText, Mode=OneWay}"
                                            Foreground="#99FFFFFF"
                                            FontSize="12"
                                            TextTrimming="CharacterEllipsis"
                                            HorizontalAlignment="Center" />
                                        <ProgressBar
                                            Minimum="0"
                                            Maximum="100"
                                            Value="{x:Bind DownloadProgress, Mode=OneWay}"
                                            IsIndeterminate="{x:Bind IsProgressIndeterminate, Mode=OneWay}"
                                            Foreground="#FF26A69A" />
                                    </StackPanel>
                                    <Image
                                        MaxWidth="1280"
                                        Stretch="Uniform"
                                        Tag="{x:Bind Index}"
                                        Source="{x:Bind Image, Mode=OneWay}"
                                        SizeChanged="OnStripImageSizeChanged" />
                                    <Canvas
                                        x:Name="StripPageOcrCanvas"
                                        Tag="{x:Bind Index}"
                                        Background="{x:Null}"
                                        IsHitTestVisible="True" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{x:Bind Label}" HorizontalAlignment="Center" Foreground="#99FFFFFF" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Initial gallery metadata loading overlay -->
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#C8141414"
                BorderBrush="#26FFFFFF"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18,12"
                IsHitTestVisible="False"
                Visibility="{x:Bind GalleryLoadingVisibility(ViewModel.IsLoading, ViewModel.ShowPagePlaceholder), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ProgressRing Width="24" Height="24" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Foreground="#FF26A69A" />
                    <TextBlock Text="正在加载画廊..." Foreground="White" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Instant page-turn placeholder with live resolution/download/decode progress -->
            <Border
                x:Name="PageLoadingPlaceholder"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinWidth="280"
                MaxWidth="360"
                Background="#D8161616"
                BorderBrush="#2EFFFFFF"
                BorderThickness="1"
                CornerRadius="12"
                Padding="22,18"
                IsHitTestVisible="False"
                Visibility="{x:Bind ViewModel.ShowPagePlaceholder, Mode=OneWay}">
                <StackPanel Spacing="10" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <ProgressRing
                            Width="22"
                            Height="22"
                            IsActive="{x:Bind ViewModel.ShowPagePlaceholder, Mode=OneWay}"
                            Foreground="#FF26A69A" />
                        <TextBlock
                            Text="{x:Bind ViewModel.PageLoadingTitle, Mode=OneWay}"
                            Foreground="#FF4DB6AC"
                            FontSize="15"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                        Text="{x:Bind ViewModel.PageLoadingStatus, Mode=OneWay}"
                        Foreground="#CCFFFFFF"
                        FontSize="12.5"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        HorizontalAlignment="Center" />
                    <ProgressBar
                        Minimum="0"
                        Maximum="100"
                        Value="{x:Bind ViewModel.PageLoadingProgress, Mode=OneWay}"
                        IsIndeterminate="{x:Bind ViewModel.IsPageLoadingIndeterminate, Mode=OneWay}"
                        Foreground="#FF26A69A" />
                </StackPanel>
            </Border>

            <!-- Android-style page/clock badge (bottom right) -->
            <Border
                x:Name="CornerInfoBadge"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="14"
                Padding="10,4"
                CornerRadius="12"
                Background="#99000000"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <TextBlock Foreground="White" FontSize="12" Text="{x:Bind ViewModel.OverlayInfoText, Mode=OneWay}" />
            </Border>

            <!-- Subtle exit-fullscreen pill -->
            <Button
                x:Name="ExitFullscreenPill"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="14"
                Padding="10,4"
                Opacity="0.78"
                Content="退出全屏 (Esc / F11)"
                Visibility="{x:Bind ViewModel.IsFullscreen, Mode=OneWay}"
                Click="OnFullscreenToggleClick" />

            <InfoBar
                VerticalAlignment="Top"
                Margin="14,68,14,0"
                Severity="Error"
                IsClosable="False"
                Visibility="{x:Bind views:UiHelpers.VisibleIfNotEmpty(ViewModel.ErrorMessage), Mode=OneWay}"
                IsOpen="{x:Bind HasText(ViewModel.ErrorMessage), Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="重试" Click="OnRetryPageClick" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Android Floating Top GalleryHeader HUD -->
            <Border
                x:Name="HeaderHudBar"
                VerticalAlignment="Top"
                Background="#DD141414"
                BorderBrush="#26FFFFFF"
                BorderThickness="0,0,0,1"
                Padding="12,8"
                Tapped="OnHudChromeTapped"
                PointerEntered="OnHudPointerEntered"
                PointerExited="OnHudPointerExited">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        Click="OnBackClick"
                        ToolTipService.ToolTip="返回并保存阅读进度">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" />
                    </Button>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock
                            Foreground="White"
                            FontSize="14.5"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis"
                            Text="{x:Bind ViewModel.GalleryTitle, Mode=OneWay}" />
                        <TextBlock
                            Foreground="#B3FFFFFF"
                            FontSize="11.5"
                            Text="{x:Bind ViewModel.OverlayInfoText, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5">
                        <ComboBox
                            Width="106"
                            CornerRadius="6"
                            SelectedIndex="{x:Bind ViewModel.LayoutIndex, Mode=TwoWay}"
                            ToolTipService.ToolTip="阅读方向">
                            <ComboBoxItem Content="左到右" />
                            <ComboBoxItem Content="右到左" />
                            <ComboBoxItem Content="纵向滚动" />
                        </ComboBox>

                        <ComboBox
                            Width="106"
                            CornerRadius="6"
                            SelectedIndex="{x:Bind ViewModel.ScaleIndex, Mode=TwoWay}"
                            ToolTipService.ToolTip="缩放模式">
                            <ComboBoxItem Content="适应屏幕" />
                            <ComboBoxItem Content="适应宽度" />
                            <ComboBoxItem Content="适应高度" />
                            <ComboBoxItem Content="原始大小" />
                        </ComboBox>

                        <ToggleButton
                            Style="{StaticResource ReaderHeaderToggleStyle}"
                            Content="双页"
                            IsChecked="{x:Bind ViewModel.DualPageMode, Mode=OneWay}"
                            Click="OnDualPageToggleClick"
                            ToolTipService.ToolTip="双页并排阅读" />

                        <ToggleButton
                            Style="{StaticResource ReaderHeaderToggleStyle}"
                            Content="首单独"
                            IsChecked="{x:Bind ViewModel.DualPageFirstAlone, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.DualPageMode, Mode=OneWay}"
                            Click="OnDualFirstAloneClick"
                            ToolTipService.ToolTip="封面单页显示" />

                        <ToggleButton
                            x:Name="BookmarkToggleButton"
                            Style="{StaticResource ReaderHeaderToggleStyle}"
                            Content="书签"
                            IsChecked="{x:Bind ViewModel.IsCurrentPageBookmarked, Mode=OneWay}"
                            Click="OnBookmarkToggleClick"
                            ToolTipService.ToolTip="添加/移除当前页书签 (B)" />

                        <Button
                            Style="{StaticResource ReaderHeaderButtonStyle}"
                            Content="书签栏"
                            ToolTipService.ToolTip="查看所有阅读书签">
                            <Button.Flyout>
                                <Flyout x:Name="BookmarksFlyout">
                                    <StackPanel Width="320" Spacing="8">
                                        <TextBlock Text="阅读书签" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <ListView
                                            MaxHeight="340"
                                            SelectionMode="None"
                                            ItemsSource="{x:Bind ViewModel.Bookmarks, Mode=OneWay}">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ReaderBookmarkItem">
                                                    <Grid ColumnSpacing="8" Padding="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Tag="{x:Bind}"
                                                            Click="OnBookmarkItemClick">
                                                            <TextBlock Text="{x:Bind Display}" TextTrimming="CharacterEllipsis" />
                                                        </Button>
                                                        <Button
                                                            Grid.Column="1"
                                                            Content="删"
                                                            Tag="{x:Bind Gid}"
                                                            Click="OnDeleteBookmarkClick" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <ToggleButton
                            x:Name="OcrModeToggleButton"
                            Style="{StaticResource ReaderHeaderToggleStyle}"
                            Content="识字"
                            Click="OnOcrModeToggleClick"
                            ToolTipService.ToolTip="本地识字框选翻译 (O)" />

                        <ToggleButton
                            x:Name="ThumbDrawerToggle"
                            Style="{StaticResource ReaderHeaderToggleStyle}"
                            Content="缩略图"
                            Click="OnToggleThumbDrawerClick"
                            ToolTipService.ToolTip="切换页面缩略图导航栏 (T)" />

                        <Button
                            Style="{StaticResource ReaderHeaderButtonStyle}"
                            Content="设置">
                            <Button.Flyout>
                                <Flyout Opened="OnSettingsFlyoutOpened">
                                    <StackPanel Width="300" Spacing="10">
                                        <TextBlock Text="阅读器实时设置" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Name="PreloadLabelText" Text="预加载页数：2" />
                                            <Slider
                                                x:Name="PreloadSlider"
                                                Minimum="1"
                                                Maximum="10"
                                                StepFrequency="1"
                                                ValueChanged="OnPreloadSliderChanged" />
                                        </StackPanel>
                                        <ComboBox
                                            x:Name="MaxEdgeComboBox"
                                            Header="最大解码边长（px）"
                                            HorizontalAlignment="Stretch"
                                            SelectionChanged="OnMaxEdgeSelectionChanged">
                                            <ComboBoxItem Content="2048" Tag="2048" />
                                            <ComboBoxItem Content="3072" Tag="3072" />
                                            <ComboBoxItem Content="4096" Tag="4096" />
                                            <ComboBoxItem Content="6144" Tag="6144" />
                                            <ComboBoxItem Content="8192" Tag="8192" />
                                        </ComboBox>
                                        <ToggleSwitch Header="强制转码至 sRGB" IsOn="{x:Bind ViewModel.ForceSrgb, Mode=TwoWay}" />
                                        <ToggleSwitch Header="显示页码与时钟角标" IsOn="{x:Bind ViewModel.ShowPageNumber, Mode=TwoWay}" />
                                        <ToggleSwitch Header="保持屏幕唤醒" IsOn="{x:Bind ViewModel.KeepScreenOn, Mode=TwoWay}" />
                                        <ToggleSwitch Header="滚轮边缘自动翻页" IsOn="{x:Bind ViewModel.PageTurnByWheel, Mode=TwoWay}" />
                                        <ToggleSwitch Header="全屏时隐藏控制栏" IsOn="{x:Bind ViewModel.HideReaderChromeInFullscreen, Mode=TwoWay}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <ToggleButton
                            Style="{StaticResource ReaderHeaderToggleStyle}"
                            Content="全屏"
                            IsChecked="{x:Bind ViewModel.IsFullscreen, Mode=OneWay}"
                            Click="OnFullscreenToggleClick"
                            ToolTipService.ToolTip="切换全屏阅读 (F11 / Esc)" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Android Floating Bottom SeekBarPanel HUD -->
            <Border
                x:Name="FooterHudBar"
                VerticalAlignment="Bottom"
                Background="#DD141414"
                BorderBrush="#26FFFFFF"
                BorderThickness="0,1,0,0"
                Padding="16,10"
                Tapped="OnHudChromeTapped"
                PointerEntered="OnHudPointerEntered"
                PointerExited="OnHudPointerExited">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Content="‹ 上一页"
                        Style="{StaticResource ReaderHeaderButtonStyle}"
                        Click="OnPreviousClick" />

                    <Slider
                        x:Name="PageSlider"
                        Grid.Column="1"
                        Minimum="1"
                        Maximum="1"
                        VerticalAlignment="Center"
                        ValueChanged="OnPageSliderValueChanged" />

                    <Button
                        x:Name="ZoomResetButton"
                        Grid.Column="2"
                        Style="{StaticResource ReaderHeaderButtonStyle}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Click="OnResetZoomClick"
                        ToolTipService.ToolTip="点击重置缩放至 100% (Ctrl+0)">
                        <TextBlock x:Name="ZoomBadgeText" Foreground="White" FontSize="12" Text="100%" />
                    </Button>

                    <Button
                        x:Name="PositionJumpButton"
                        Grid.Column="3"
                        Style="{StaticResource ReaderHeaderButtonStyle}"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="点击输入页码跳转 (G)">
                        <TextBlock
                            Foreground="White"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" />
                        <Button.Flyout>
                            <Flyout x:Name="PageJumpFlyout" Opened="OnPageJumpFlyoutOpened">
                                <StackPanel Width="220" Spacing="10">
                                    <TextBlock Text="跳转到页码" FontWeight="SemiBold" />
                                    <NumberBox
                                        x:Name="PageJumpBox"
                                        Minimum="1"
                                        SpinButtonPlacementMode="Compact"
                                        KeyDown="OnPageJumpBoxKeyDown" />
                                    <Button
                                        Content="跳转"
                                        Style="{StaticResource EhTealPrimaryButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Click="OnConfirmPageJumpClick" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button
                        Grid.Column="4"
                        Content="下一页 ›"
                        Style="{StaticResource ReaderHeaderButtonStyle}"
                        Click="OnNextClick" />
                </Grid>
            </Border>
        </Grid>

        <!-- Collapsible page thumbnail / quick jump drawer -->
        <Border
            x:Name="ThumbnailDrawer"
            Grid.Column="1"
            Width="210"
            Background="#EE1B1B1B"
            BorderBrush="#33FFFFFF"
            BorderThickness="1,0,0,0"
            Visibility="Collapsed">
            <Grid RowSpacing="8" Padding="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="页面列表" Foreground="White" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <ListView
                    x:Name="ThumbnailListView"
                    Grid.Row="1"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    SingleSelectionFollowsFocus="False"
                    ItemsSource="{x:Bind ViewModel.ThumbnailItems, Mode=OneWay}"
                    ItemClick="OnThumbnailItemClick"
                    ContainerContentChanging="OnThumbContainerContentChanging">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="6" />
                            <Setter Property="Margin" Value="0,3" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Grid>
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal" />
                                                    <VisualState x:Name="PointerOver">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ThumbCard" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#24FFFFFF" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="Pressed">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ThumbCard" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#36FFFFFF" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="Selected">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ThumbCard" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#38009688" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ThumbCard" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FF26A69A" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="PointerOverSelected">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ThumbCard" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#48009688" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ThumbCard" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FF4DB6AC" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="SelectedUnfocused">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ThumbCard" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#38009688" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ThumbCard" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FF26A69A" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                            <Border
                                                x:Name="ThumbCard"
                                                Background="#14FFFFFF"
                                                BorderBrush="#22FFFFFF"
                                                BorderThickness="1.5"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                                <ContentPresenter
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReaderThumbnailItem">
                            <StackPanel Spacing="4">
                                <Border Height="96" CornerRadius="4" Background="#1AFFFFFF">
                                    <Grid>
                                        <FontIcon
                                            x:Name="ThumbPlaceholder"
                                            Glyph="&#xEB9F;"
                                            FontSize="20"
                                            Foreground="#66FFFFFF"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                        <Image x:Name="ThumbImage" Stretch="Uniform" Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{x:Bind Label}" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- On-demand OCR status pill -->
        <Border
            x:Name="OcrStatusPill"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,22"
            Padding="14,7"
            CornerRadius="18"
            Background="#E014181A"
            BorderBrush="#4426A69A"
            BorderThickness="1"
            Visibility="Collapsed"
            Tapped="OnHudChromeTapped">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing
                    x:Name="OcrScanProgressRing"
                    Width="15"
                    Height="15"
                    IsActive="False"
                    Visibility="Collapsed"
                    Foreground="#FF4DB6AC" />
                <TextBlock
                    x:Name="OcrStatusText"
                    MaxWidth="280"
                    TextTrimming="CharacterEllipsis"
                    Foreground="#E6FFFFFF"
                    FontSize="12.5"
                    VerticalAlignment="Center"
                    Text="正在本地识别当前页文字..." />
                <ComboBox
                    x:Name="OcrPillEngineComboBox"
                    MinWidth="136"
                    FontSize="11.5"
                    Padding="8,3"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="切换当前阅读器翻译引擎"
                    SelectionChanged="OnOcrEngineOverrideSelectionChanged">
                    <ComboBoxItem Content="传统直译 (免配置)" Tag="direct-mt" />
                    <ComboBoxItem Content="本地 Sakura-7B" Tag="llama-sakura" />
                    <ComboBoxItem Content="自定义 OpenAI" Tag="openai-compat" />
                    <ComboBoxItem Content="DeepSeek AI (低推理)" Tag="deepseek" />
                </ComboBox>
                <Button
                    x:Name="TranslateAllOcrButton"
                    Content="翻译全页"
                    AutomationProperties.Name="翻译全页"
                    Padding="8,2"
                    FontSize="11.5"
                    Background="#3D00BFA5"
                    Foreground="#FFE0F2F1"
                    Visibility="Collapsed"
                    Click="OnTranslateAllOcrClick" />
                <ToggleButton
                    x:Name="InlineTranslationToggleButton"
                    Content="内嵌译文"
                    AutomationProperties.Name="内嵌译文"
                    Padding="8,2"
                    FontSize="11.5"
                    IsChecked="True"
                    Visibility="Collapsed"
                    Click="OnInlineTranslationToggleClick" />
                <ToggleButton
                    x:Name="InlineStyleToggleButton"
                    Content="填底嵌字"
                    AutomationProperties.Name="嵌字样式"
                    ToolTipService.ToolTip="切换：填底嵌字（自动采样底色覆盖原文） / 紧凑角标"
                    Padding="8,2"
                    FontSize="11.5"
                    IsChecked="True"
                    Visibility="Collapsed"
                    Click="OnInlineStyleToggleClick" />
                <ToggleButton
                    x:Name="AutoTranslateToggleButton"
                    Content="自动连译"
                    AutomationProperties.Name="自动连译"
                    ToolTipService.ToolTip="开启后翻页或纵向滚动停顿时自动检测并内嵌翻译全部气泡"
                    Padding="8,2"
                    FontSize="11.5"
                    IsChecked="False"
                    Visibility="Collapsed"
                    Click="OnAutoTranslateToggleClick" />
                <Button
                    Content="退出识字"
                    Padding="8,2"
                    FontSize="11.5"
                    Background="#22FFFFFF"
                    Foreground="#CCFFFFFF"
                    Click="OnCloseOcrModeClick" />
            </StackPanel>
        </Border>

        <!-- Click-to-translate floating card (hidden cleanly by Boss Key) -->
        <Border
            x:Name="OcrTranslationCard"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Margin="0,0,22,0"
            Width="420"
            MaxWidth="460"
            MaxHeight="540"
            Padding="16"
            CornerRadius="14"
            Background="#F216181D"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            Visibility="Collapsed"
            Tapped="OnHudChromeTapped">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="气泡识字译文"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#FF4DB6AC"
                            VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button
                                x:Name="PrevOcrBubbleButton"
                                Content="‹"
                                Padding="7,2"
                                FontSize="13"
                                MinWidth="26"
                                Click="OnPrevOcrBubbleClick"
                                ToolTipService.ToolTip="上一个气泡（按阅读顺序）" />
                            <TextBlock
                                x:Name="OcrBubblePositionText"
                                Text="-"
                                FontSize="11.5"
                                Foreground="#CCFFFFFF"
                                VerticalAlignment="Center"
                                MinWidth="28"
                                TextAlignment="Center" />
                            <Button
                                x:Name="NextOcrBubbleButton"
                                Content="›"
                                Padding="7,2"
                                FontSize="13"
                                MinWidth="26"
                                Click="OnNextOcrBubbleClick"
                                ToolTipService.ToolTip="下一个气泡（按阅读顺序）" />
                        </StackPanel>
                        <ComboBox
                            x:Name="OcrEngineOverrideComboBox"
                            Grid.Column="2"
                            MinWidth="148"
                            FontSize="12"
                            SelectionChanged="OnOcrEngineOverrideSelectionChanged">
                            <ComboBoxItem Content="传统直译 (免配置)" Tag="direct-mt" />
                            <ComboBoxItem Content="本地 Sakura-7B" Tag="llama-sakura" />
                            <ComboBoxItem Content="自定义 OpenAI" Tag="openai-compat" />
                            <ComboBoxItem Content="DeepSeek AI (低推理)" Tag="deepseek" />
                        </ComboBox>
                        <Button
                            Grid.Column="3"
                            Content="✕"
                            Padding="8,4"
                            Background="#1EFFFFFF"
                            Foreground="White"
                            Click="OnCloseOcrCardClick"
                            ToolTipService.ToolTip="关闭译文卡片 (Esc)" />
                    </Grid>

                    <StackPanel Spacing="4">
                        <Grid>
                            <TextBlock Text="识别原文（可编辑修正）" FontSize="11.5" Foreground="#99FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                <Button
                                    Content="复制原文"
                                    Padding="8,3"
                                    FontSize="11.5"
                                    Click="OnCopyOcrSourceClick" />
                                <Button
                                    Content="重新翻译"
                                    Padding="8,3"
                                    FontSize="11.5"
                                    Background="#3326A69A"
                                    Foreground="White"
                                    Click="OnRetranslateOcrClick" />
                            </StackPanel>
                        </Grid>
                        <TextBox
                            x:Name="OcrSourceTextBox"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MaxHeight="110"
                            FontSize="13.5"
                            Background="#18FFFFFF"
                            Foreground="White" />
                    </StackPanel>

                    <Border Height="1" Background="#22FFFFFF" />

                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="中文译文" FontSize="11.5" Foreground="#99FFFFFF" VerticalAlignment="Center" />
                            <Button
                                HorizontalAlignment="Right"
                                Content="复制译文"
                                Padding="8,3"
                                FontSize="11.5"
                                Click="OnCopyOcrTranslationClick" />
                        </Grid>
                        <ProgressBar
                            x:Name="OcrTranslateProgress"
                            IsIndeterminate="True"
                            Visibility="Collapsed"
                            Foreground="#FF4DB6AC" />
                        <TextBlock
                            x:Name="OcrTranslatedTextBlock"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap"
                            FontSize="15"
                            LineHeight="22"
                            Foreground="White"
                            Text="点击页面上高亮气泡即可翻译。" />
                        <TextBlock
                            x:Name="OcrProviderNoteText"
                            TextWrapping="Wrap"
                            FontSize="11.5"
                            Foreground="#AA80CBC4"
                            Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
