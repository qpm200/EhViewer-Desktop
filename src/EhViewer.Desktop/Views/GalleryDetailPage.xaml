<Page
    x:Class="EhViewer.Desktop.Views.GalleryDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EhViewer.Desktop.Controls"
    xmlns:coreData="using:EhViewer.Core.Client.Data"
    xmlns:vm="using:EhViewer.Desktop.ViewModels"
    xmlns:views="using:EhViewer.Desktop.Views"
    Background="{StaticResource EhPageBackgroundBrush}">

    <Grid>
        <!-- Initial Loading Overlay -->
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind views:GalleryDetailPage.VisibleWhenInitialLoading(ViewModel.IsLoading, ViewModel.IsLoaded), Mode=OneWay}">
            <ProgressRing IsActive="True" Width="42" Height="42" />
            <TextBlock
                Text="正在加载画廊详情..."
                FontSize="13.5"
                Foreground="{StaticResource EhTextSecondaryBrush}" />
        </StackPanel>

        <!-- Error Overlay -->
        <Border
            MaxWidth="460"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource EhMaterialCardStyle}"
            Visibility="{x:Bind views:GalleryDetailPage.VisibleWhenFatalError(ViewModel.HasError, ViewModel.IsLoaded), Mode=OneWay}">
            <StackPanel Spacing="14" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE783;" FontSize="32" Foreground="{StaticResource EhPrimaryBrush}" />
                <TextBlock
                    Text="画廊详情加载失败"
                    FontSize="16"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Foreground="{StaticResource EhTextPrimaryBrush}" />
                <TextBlock
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    FontSize="13"
                    TextWrapping="Wrap"
                    HorizontalTextAlignment="Center"
                    Foreground="{StaticResource EhTextSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Button Content="返回" Click="OnBackClick" />
                    <Button Style="{StaticResource EhTealPrimaryButtonStyle}" Content="重试" Click="OnRefreshDetailClick" />
                    <Button Content="在浏览器打开" Click="OnOpenInBrowserClick" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Android Material Detail Scroll Scene -->
        <ScrollViewer
            x:Name="DetailScroller"
            Visibility="{x:Bind views:UiHelpers.VisibleIf(ViewModel.IsLoaded), Mode=OneWay}">
            <StackPanel Spacing="0" Padding="0,0,0,32">

                <!-- 1. Android gallery_detail_header Hero Band -->
                <Border
                    Background="{StaticResource EhDrawerHeaderBrush}"
                    Padding="24,10,24,38">
                    <StackPanel HorizontalAlignment="Stretch" Spacing="14">
                        <!-- Top AppBar Strip -->
                        <Grid Height="42">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Style="{StaticResource EhToolbarIconButtonStyle}"
                                ToolTipService.ToolTip="返回"
                                Click="OnBackClick">
                                <FontIcon Glyph="&#xE72B;" FontSize="17" />
                            </Button>

                            <TextBlock
                                Grid.Column="1"
                                x:Name="TopGidBadgeText"
                                Text="画廊详情"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="14.5"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource EhToolbarForegroundBrush}"
                                Opacity="0.92" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                <Button
                                    Style="{StaticResource EhToolbarIconButtonStyle}"
                                    ToolTipService.ToolTip="刷新画廊详情"
                                    Click="OnRefreshDetailClick">
                                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                                </Button>
                                <Button
                                    Style="{StaticResource EhToolbarIconButtonStyle}"
                                    ToolTipService.ToolTip="在独立阅读窗口打开"
                                    Click="OnOpenInNewWindowClick">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="16" />
                                </Button>
                                <Button
                                    Style="{StaticResource EhToolbarIconButtonStyle}"
                                    ToolTipService.ToolTip="更多操作"
                                    Click="OnHeaderOverflowClick">
                                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Hero Cover + Metadata -->
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="142"
                                Height="202"
                                CornerRadius="6"
                                Background="#33000000"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                VerticalAlignment="Top"
                                Tapped="OnCoverTapped"
                                ToolTipService.ToolTip="点击从第 1 页开始阅读">
                                <Grid>
                                    <FontIcon
                                        x:Name="CoverPlaceholderIcon"
                                        Glyph="&#xEB9F;"
                                        FontSize="32"
                                        Foreground="#80FFFFFF"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                    <Image x:Name="HeroCoverImage" Stretch="UniformToFill" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Top">
                                <TextBlock
                                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                                    FontSize="18.5"
                                    FontWeight="SemiBold"
                                    Foreground="#FFFFFFFF"
                                    TextWrapping="Wrap"
                                    MaxLines="4"
                                    TextTrimming="CharacterEllipsis"
                                    IsTextSelectionEnabled="True" />

                                <TextBlock
                                    Text="{x:Bind ViewModel.TitleJpn, Mode=OneWay}"
                                    FontSize="12.5"
                                    Foreground="#CCFFFFFF"
                                    TextWrapping="Wrap"
                                    MaxLines="2"
                                    TextTrimming="CharacterEllipsis"
                                    IsTextSelectionEnabled="True"
                                    Visibility="{x:Bind views:UiHelpers.VisibleIfNotEmpty(ViewModel.TitleJpn), Mode=OneWay}" />

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Border
                                        x:Name="HeroCategoryBadge"
                                        Background="{StaticResource EhPrimaryBrush}"
                                        CornerRadius="3"
                                        Padding="8,3"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            Text="{x:Bind ViewModel.CategoryName, Mode=OneWay}"
                                            FontSize="11.5"
                                            FontWeight="Bold"
                                            Foreground="#FFFFFFFF" />
                                    </Border>

                                    <Button
                                        Padding="8,3"
                                        MinHeight="0"
                                        Background="#26FFFFFF"
                                        BorderThickness="0"
                                        CornerRadius="3"
                                        Foreground="#FFFFFFFF"
                                        Visibility="{x:Bind views:UiHelpers.VisibleIfNotEmpty(ViewModel.Uploader), Mode=OneWay}"
                                        Click="OnUploaderClick"
                                        ToolTipService.ToolTip="点击按上传者搜索">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE77B;" FontSize="11.5" />
                                            <TextBlock Text="{x:Bind ViewModel.Uploader, Mode=OneWay}" FontSize="12" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        Padding="8,3"
                                        MinHeight="0"
                                        Background="#26FFFFFF"
                                        BorderThickness="0"
                                        CornerRadius="3"
                                        Foreground="#FFFFFFFF"
                                        Visibility="{x:Bind views:UiHelpers.VisibleIf(ViewModel.HasParent), Mode=OneWay}"
                                        Click="OnOpenParentClick"
                                        ToolTipService.ToolTip="打开父画廊">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE895;" FontSize="11.5" />
                                            <TextBlock Text="父画廊" FontSize="11.5" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Newer Versions Row -->
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Margin="0,2,0,0"
                                    Visibility="{x:Bind views:UiHelpers.VisibleIf(ViewModel.HasVersions), Mode=OneWay}">
                                    <FontIcon Glyph="&#xE898;" FontSize="12.5" Foreground="#E0FFFFFF" />
                                    <TextBlock
                                        Text="发现新版本："
                                        FontSize="12"
                                        VerticalAlignment="Center"
                                        Foreground="#E0FFFFFF" />
                                    <Button
                                        x:Name="VersionsPickerBtn"
                                        Padding="8,3"
                                        Background="#33FFFFFF"
                                        BorderThickness="0"
                                        Foreground="#FFFFFFFF"
                                        FontSize="12"
                                        Content="选择新版本 ▾"
                                        Click="OnVersionsPickerClick" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. Overlapping Android action_card (Download | Read) -->
                <Grid Padding="24,0" Margin="0,-24,0,12">
                    <Border
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource EhFloatingCardStyle}"
                        Padding="0">
                        <Grid Height="54">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                x:Name="DownloadCtaBtn"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="8,0,0,8"
                                Foreground="{StaticResource EhTextPrimaryBrush}"
                                Click="OnDownloadClick">
                                <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE896;" FontSize="17" Foreground="{StaticResource EhPrimaryBrush}" />
                                    <TextBlock
                                        x:Name="DownloadCtaLabel"
                                        Text="下载画廊"
                                        FontSize="14.5"
                                        FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Rectangle Grid.Column="1" Fill="{StaticResource EhDividerBrush}" Margin="0,10" />

                            <Button
                                x:Name="ReadCtaBtn"
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="{StaticResource EhPrimaryBrush}"
                                BorderThickness="0"
                                CornerRadius="0,8,8,0"
                                Foreground="#FFFFFFFF"
                                Click="OnReadClick">
                                <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE736;" FontSize="17" />
                                    <TextBlock x:Name="ReadCtaLabel" Text="开始阅读" FontSize="14.5" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Main Card Stack -->
                <Grid Padding="24,0">
                    <StackPanel HorizontalAlignment="Stretch" Spacing="12">

                    <!-- 3. Clickable Android gallery_detail_info Card -> pushes GalleryInfoPage -->
                    <Border
                        Style="{StaticResource EhMaterialCardStyle}"
                        Padding="16,12"
                        Tapped="OnInfoCardTapped"
                        ToolTipService.ToolTip="点击查看完整画廊信息">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="18">
                                    <TextBlock FontSize="13" Foreground="{StaticResource EhTextPrimaryBrush}">
                                        <Run Text="语言：" Foreground="{StaticResource EhTextSecondaryBrush}" />
                                        <Run Text="{x:Bind ViewModel.Language, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock FontSize="13" Foreground="{StaticResource EhTextPrimaryBrush}">
                                        <Run Text="页数：" Foreground="{StaticResource EhTextSecondaryBrush}" />
                                        <Run Text="{x:Bind ViewModel.PagesText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock FontSize="13" Foreground="{StaticResource EhTextPrimaryBrush}">
                                        <Run Text="大小：" Foreground="{StaticResource EhTextSecondaryBrush}" />
                                        <Run Text="{x:Bind ViewModel.FileSize, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="18">
                                    <TextBlock FontSize="12.5" Foreground="{StaticResource EhTextPrimaryBrush}">
                                        <Run Text="收藏数：" Foreground="{StaticResource EhTextSecondaryBrush}" />
                                        <Run Text="{x:Bind ViewModel.FavoriteCountText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock FontSize="12.5" Foreground="{StaticResource EhTextPrimaryBrush}">
                                        <Run Text="上传于：" Foreground="{StaticResource EhTextSecondaryBrush}" />
                                        <Run Text="{x:Bind ViewModel.Posted, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Text="更多信息"
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource EhPrimaryBrush}"
                                    VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE76C;" FontSize="12" Foreground="{StaticResource EhPrimaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 4. Android gallery_detail_actions Row + Rating Bar Card -->
                    <Border Style="{StaticResource EhMaterialCardStyle}" Padding="12,10">
                        <StackPanel Spacing="10">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="6" Padding="0,0,0,12">
                                    <!-- Favorite -->
                                    <Button
                                        x:Name="FavoriteActionBtn"
                                        MinWidth="84"
                                        Padding="10,8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnFavoriteClick"
                                        RightTapped="OnFavoriteRightTapped"
                                        ToolTipService.ToolTip="左键选择收藏夹，右键快速切换收藏">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <FontIcon
                                                x:Name="FavoriteActionIcon"
                                                Glyph="&#xEB51;"
                                                FontSize="18"
                                                Foreground="{StaticResource EhPrimaryBrush}" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.FavoriteButtonText, Mode=OneWay}"
                                                FontSize="11.5"
                                                Foreground="{StaticResource EhTextPrimaryBrush}"
                                                HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Rate -->
                                    <Button
                                        MinWidth="74"
                                        Padding="10,8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnRateClick">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE734;" FontSize="18" Foreground="{StaticResource EhPrimaryBrush}" />
                                            <TextBlock Text="评分" FontSize="11.5" Foreground="{StaticResource EhTextPrimaryBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Torrents -->
                                    <Button
                                        MinWidth="84"
                                        Padding="10,8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        IsEnabled="{x:Bind ViewModel.HasTorrents, Mode=OneWay}"
                                        Click="OnTorrentClick">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE753;" FontSize="18" Foreground="{StaticResource EhPrimaryBrush}" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.TorrentButtonText, Mode=OneWay}"
                                                FontSize="11.5"
                                                Foreground="{StaticResource EhTextPrimaryBrush}"
                                                HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Archiver -->
                                    <Button
                                        MinWidth="80"
                                        Padding="10,8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnArchiverClick">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE7B8;" FontSize="18" Foreground="{StaticResource EhPrimaryBrush}" />
                                            <TextBlock Text="Archiver" FontSize="11.5" Foreground="{StaticResource EhTextPrimaryBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- H@H -->
                                    <Button
                                        MinWidth="74"
                                        Padding="10,8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnHathClick">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE968;" FontSize="18" Foreground="{StaticResource EhPrimaryBrush}" />
                                            <TextBlock Text="H@H 下载" FontSize="11.5" Foreground="{StaticResource EhTextPrimaryBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Similar -->
                                    <Button
                                        MinWidth="76"
                                        Padding="10,8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnSimilarClick">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE721;" FontSize="18" Foreground="{StaticResource EhPrimaryBrush}" />
                                            <TextBlock Text="相似画廊" FontSize="11.5" Foreground="{StaticResource EhTextPrimaryBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Search Cover -->
                                    <Button
                                        MinWidth="76"
                                        Padding="10,8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnSearchCoverClick">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xEB9F;" FontSize="18" Foreground="{StaticResource EhPrimaryBrush}" />
                                            <TextBlock Text="以封面搜" FontSize="11.5" Foreground="{StaticResource EhTextPrimaryBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Share / Copy URL -->
                                    <Button
                                        MinWidth="74"
                                        Padding="10,8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnShareClick">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE72D;" FontSize="18" Foreground="{StaticResource EhPrimaryBrush}" />
                                            <TextBlock Text="分享链接" FontSize="11.5" Foreground="{StaticResource EhTextPrimaryBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>

                            <Rectangle Height="1" Fill="{StaticResource EhDividerBrush}" />

                            <!-- Large Rating Row (tap to rate) -->
                            <Grid Background="Transparent" Padding="6,2" Tapped="OnRatingStripTapped">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <controls:SimpleRatingView x:Name="ActionsSimpleRating" StarSize="22" VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Text="{x:Bind ViewModel.RatingText, Mode=OneWay}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource EhTextPrimaryBrush}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="点击评分 ›"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource EhPrimaryBrush}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 5. Grouped Tag Chips Card -->
                    <Border Style="{StaticResource EhMaterialCardStyle}" Padding="16,14">
                        <StackPanel Spacing="10">
                            <TextBlock
                                Text="标签"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource EhTextPrimaryBrush}" />

                            <TextBlock
                                Text="暂无标签。"
                                FontSize="12.5"
                                Foreground="{StaticResource EhTextSecondaryBrush}"
                                Visibility="{x:Bind views:GalleryDetailPage.VisibleWhenEmptyCount(ViewModel.TagGroups.Count), Mode=OneWay}" />

                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.TagGroups}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TagGroupViewModel">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Background="{StaticResource EhSubtleSurfaceBrush}"
                                                CornerRadius="4"
                                                Padding="8,5"
                                                VerticalAlignment="Top">
                                                <TextBlock
                                                    Text="{x:Bind GroupName}"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource EhTextSecondaryBrush}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Border>

                                            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Tags}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <controls:TagWrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:TagChip">
                                                        <Button
                                                            Padding="9,4"
                                                            MinHeight="0"
                                                            FontSize="12"
                                                            Background="{StaticResource EhTagBackgroundBrush}"
                                                            BorderBrush="{StaticResource EhTagBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Foreground="{StaticResource EhTextPrimaryBrush}"
                                                            Content="{x:Bind Display}"
                                                            Tag="{x:Bind}"
                                                            Click="OnTagChipClick" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <!-- 6. Previews Section Card -->
                    <Border Style="{StaticResource EhMaterialCardStyle}" Padding="16,14">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="预览"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource EhTextPrimaryBrush}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.PreviewPageText, Mode=OneWay}"
                                        FontSize="12"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource EhTextSecondaryBrush}"
                                        Visibility="{x:Bind views:UiHelpers.VisibleIf(ViewModel.HasMultiplePreviewPages), Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button
                                        Padding="8,4"
                                        Content="‹"
                                        IsEnabled="{x:Bind ViewModel.CanPreviousPreview, Mode=OneWay}"
                                        Visibility="{x:Bind views:UiHelpers.VisibleIf(ViewModel.HasMultiplePreviewPages), Mode=OneWay}"
                                        Click="OnPrevPreviewPageClick" />
                                    <Button
                                        Padding="8,4"
                                        Content="›"
                                        IsEnabled="{x:Bind ViewModel.CanNextPreview, Mode=OneWay}"
                                        Visibility="{x:Bind views:UiHelpers.VisibleIf(ViewModel.HasMultiplePreviewPages), Mode=OneWay}"
                                        Click="OnNextPreviewPageClick" />
                                    <Button
                                        Style="{StaticResource EhAccentFlatButtonStyle}"
                                        Content="查看全部 ›"
                                        Click="OnOpenAllPreviewsClick" />
                                </StackPanel>
                            </Grid>

                            <ItemsRepeater
                                x:Name="PreviewStripRepeater"
                                ItemsSource="{x:Bind ViewModel.Previews}"
                                ElementPrepared="OnPreviewElementPrepared"
                                ElementClearing="OnPreviewElementClearing">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        MinItemWidth="128"
                                        MinItemHeight="188"
                                        MinRowSpacing="8"
                                        MinColumnSpacing="8"
                                        ItemsStretch="Fill" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PreviewTileViewModel">
                                        <Border
                                            Background="{StaticResource EhSubtleSurfaceBrush}"
                                            BorderBrush="{StaticResource EhCardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="3"
                                            Tag="{x:Bind}"
                                            Tapped="OnPreviewTileTapped">
                                            <Grid>
                                                <FontIcon
                                                    Glyph="&#xEB9F;"
                                                    FontSize="22"
                                                    Foreground="{StaticResource EhTextSecondaryBrush}"
                                                    Opacity="0.45"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                                <Image Stretch="Uniform" />
                                                <Border
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Bottom"
                                                    Margin="0,0,0,4"
                                                    Background="#B0000000"
                                                    CornerRadius="8"
                                                    Padding="7,1">
                                                    <TextBlock
                                                        Text="{x:Bind views:GalleryPreviewsPage.FormatPageNumber(Position)}"
                                                        FontSize="11"
                                                        Foreground="#FFFFFFFF" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <!-- 7. Comments Preview + Composer Card -->
                    <Border Style="{StaticResource EhMaterialCardStyle}" Padding="16,14">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    x:Name="CommentsHeaderText"
                                    Text="评论"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource EhTextPrimaryBrush}" />

                                <Button
                                    Grid.Column="1"
                                    Style="{StaticResource EhAccentFlatButtonStyle}"
                                    Content="全部评论 / 发表 ›"
                                    Click="OnOpenAllCommentsClick" />
                            </Grid>

                            <TextBlock
                                x:Name="CommentsEmptyText"
                                Text="暂无评论。"
                                FontSize="12.5"
                                Foreground="{StaticResource EhTextSecondaryBrush}" />

                            <ItemsRepeater x:Name="CommentsPreviewRepeater">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CommentViewModel">
                                        <Border
                                            Background="{StaticResource EhSubtleSurfaceBrush}"
                                            CornerRadius="6"
                                            Padding="12,10">
                                            <StackPanel Spacing="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock
                                                            Text="{x:Bind User}"
                                                            FontSize="12.5"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource EhPrimaryBrush}" />
                                                        <TextBlock
                                                            Text="{x:Bind TimeText}"
                                                            FontSize="11.5"
                                                            Foreground="{StaticResource EhTextSecondaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{x:Bind ScoreText}"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource EhTextSecondaryBrush}" />
                                                </Grid>
                                                <TextBlock
                                                    Text="{x:Bind Body}"
                                                    FontSize="12.5"
                                                    TextWrapping="Wrap"
                                                    MaxLines="5"
                                                    TextTrimming="CharacterEllipsis"
                                                    Foreground="{StaticResource EhTextPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <Button
                                Style="{StaticResource EhAccentFlatButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Content="打开评论区（投票 / 回复 / 编辑 / 屏蔽评论者）"
                                Click="OnOpenAllCommentsClick" />
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
