<Page
    x:Class="EhViewer.Desktop.Views.GalleryCommentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EhViewer.Desktop.Controls"
    xmlns:vm="using:EhViewer.Desktop.ViewModels"
    xmlns:views="using:EhViewer.Desktop.Views"
    Background="{StaticResource EhPageBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:MaterialToolbar
            x:Name="Toolbar"
            Title="全部评论"
            ShowBackButton="True"
            BackRequested="OnBackRequested">
            <controls:MaterialToolbar.RightActions>
                <Button
                    Style="{StaticResource EhToolbarIconButtonStyle}"
                    ToolTipService.ToolTip="刷新评论"
                    Click="OnRefreshCommentsClick">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                </Button>
            </controls:MaterialToolbar.RightActions>
        </controls:MaterialToolbar>

        <ScrollViewer Grid.Row="1" Padding="24,14,24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="10">
                <TextBlock
                    x:Name="EmptyCommentsText"
                    Text="暂无评论，欢迎发表第一条评论。"
                    FontSize="13"
                    HorizontalAlignment="Center"
                    Margin="0,36,0,0"
                    Foreground="{StaticResource EhTextSecondaryBrush}" />

                <ItemsRepeater x:Name="CommentsRepeater">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="10" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:CommentViewModel">
                            <Border Style="{StaticResource EhMaterialCardStyle}" Padding="14,12">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontWeight="SemiBold"
                                                FontSize="13"
                                                Foreground="{StaticResource EhPrimaryBrush}"
                                                Content="{x:Bind User}"
                                                Tag="{x:Bind}"
                                                Click="OnCommentAuthorClick"
                                                ToolTipService.ToolTip="评论者操作" />
                                            <TextBlock
                                                Text="{x:Bind TimeText}"
                                                FontSize="11.5"
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource EhTextSecondaryBrush}" />
                                            <TextBlock
                                                Text="{x:Bind LastEditedText}"
                                                FontSize="11"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind views:UiHelpers.VisibleIf(HasLastEdited)}"
                                                Foreground="{StaticResource EhTextSecondaryBrush}" />
                                        </StackPanel>

                                        <Border
                                            Grid.Column="1"
                                            Background="{StaticResource EhSubtleSurfaceBrush}"
                                            CornerRadius="10"
                                            Padding="8,2">
                                            <TextBlock
                                                Text="{x:Bind ScoreText}"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource EhTextPrimaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <TextBlock
                                        Text="{x:Bind Body}"
                                        FontSize="13"
                                        TextWrapping="Wrap"
                                        IsTextSelectionEnabled="True"
                                        Foreground="{StaticResource EhTextPrimaryBrush}" />

                                    <ItemsRepeater
                                        ItemsSource="{x:Bind LinksList}"
                                        Visibility="{x:Bind views:UiHelpers.VisibleIf(HasLinks)}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal" Spacing="6" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CommentLinkViewModel">
                                                <Button
                                                    Padding="8,3"
                                                    FontSize="11.5"
                                                    Background="{StaticResource EhTagBackgroundBrush}"
                                                    BorderBrush="{StaticResource EhTagBorderBrush}"
                                                    Foreground="{StaticResource EhPrimaryBrush}"
                                                    Content="{x:Bind Label}"
                                                    Tag="{x:Bind Url}"
                                                    Click="OnCommentLinkClick" />
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>

                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                        <Button
                                            Padding="8,4"
                                            FontSize="12"
                                            Style="{StaticResource EhAccentFlatButtonStyle}"
                                            Content="引用回复"
                                            Tag="{x:Bind}"
                                            Click="OnReplyCommentClick" />
                                        <Button
                                            Padding="8,4"
                                            FontSize="12"
                                            Style="{StaticResource EhAccentFlatButtonStyle}"
                                            Content="{x:Bind VoteUpLabel}"
                                            Visibility="{x:Bind views:UiHelpers.VisibleIf(VoteUpAble)}"
                                            Tag="{x:Bind}"
                                            Click="OnVoteUpClick" />
                                        <Button
                                            Padding="8,4"
                                            FontSize="12"
                                            Style="{StaticResource EhAccentFlatButtonStyle}"
                                            Content="{x:Bind VoteDownLabel}"
                                            Visibility="{x:Bind views:UiHelpers.VisibleIf(VoteDownAble)}"
                                            Tag="{x:Bind}"
                                            Click="OnVoteDownClick" />
                                        <Button
                                            Padding="8,4"
                                            FontSize="12"
                                            Style="{StaticResource EhAccentFlatButtonStyle}"
                                            Content="编辑"
                                            Visibility="{x:Bind views:UiHelpers.VisibleIf(Editable)}"
                                            Tag="{x:Bind}"
                                            Click="OnEditCommentClick" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Android-style sticky comment composer -->
        <Border
            Grid.Row="2"
            Background="{StaticResource EhCardSurfaceBrush}"
            BorderBrush="{StaticResource EhDividerBrush}"
            BorderThickness="0,1,0,0"
            Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                <Grid x:Name="EditingBanner" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="EditingBannerText"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource EhPrimaryBrush}"
                        VerticalAlignment="Center" />
                    <Button
                        Grid.Column="1"
                        Padding="8,3"
                        FontSize="12"
                        Content="取消编辑"
                        Click="OnCancelEditClick" />
                </Grid>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="CommentInputBox"
                        PlaceholderText="发表评论（支持 E-Hentai 换行，至少 10 个字符）..."
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="56"
                        MaxHeight="130" />
                    <Button
                        x:Name="SubmitCommentBtn"
                        Grid.Column="1"
                        Style="{StaticResource EhTealPrimaryButtonStyle}"
                        VerticalAlignment="Bottom"
                        Height="40"
                        MinWidth="96"
                        Content="发送评论"
                        Click="OnSubmitCommentClick" />
                </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
