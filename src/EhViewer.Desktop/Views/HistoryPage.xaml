<Page
    x:Class="EhViewer.Desktop.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EhViewer.Desktop.Controls"
    xmlns:vm="using:EhViewer.Desktop.ViewModels"
    xmlns:views="using:EhViewer.Desktop.Views"
    Background="{StaticResource EhPageBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:MaterialToolbar
            Title="浏览历史"
            Subtitle="{x:Bind ViewModel.CountText, Mode=OneWay}">
            <controls:MaterialToolbar.RightActions>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button
                        Style="{StaticResource EhToolbarIconButtonStyle}"
                        ToolTipService.ToolTip="刷新历史记录"
                        Click="OnRefreshClick">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    </Button>
                    <Button
                        Style="{StaticResource EhToolbarIconButtonStyle}"
                        ToolTipService.ToolTip="清空全部历史"
                        Click="OnClearClick">
                        <FontIcon Glyph="&#xE74D;" FontSize="16" />
                    </Button>
                </StackPanel>
            </controls:MaterialToolbar.RightActions>
        </controls:MaterialToolbar>

        <!-- Local Filter Bar -->
        <Border
            Grid.Row="1"
            Background="{StaticResource EhCardSurfaceBrush}"
            BorderBrush="{StaticResource EhDividerBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,10">
            <StackPanel Spacing="0">
                <TextBox
                    x:Name="FilterBox"
                    PlaceholderText="按标题、上传者或 GID 筛选历史..."
                    TextChanged="OnFilterTextChanged" />
                <InfoBar
                    Margin="0,8,0,0"
                    Visibility="{x:Bind views:UiHelpers.VisibleIfNotEmpty(ViewModel.ErrorMessage), Mode=OneWay}"
                    IsOpen="{x:Bind HasError(ViewModel.ErrorMessage), Mode=OneWay}"
                    Severity="Error"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <TextBlock
                x:Name="EmptyText"
                Text="暂无历史记录。"
                FontSize="13.5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{StaticResource EhTextSecondaryBrush}" />

            <ScrollViewer Padding="16,12">
                <ItemsRepeater
                    x:Name="HistoryRepeater"
                    ElementPrepared="OnRowElementPrepared"
                    ElementClearing="OnRowElementClearing">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="10" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryRow">
                            <Border
                                Style="{StaticResource EhMaterialCardStyle}"
                                Height="132"
                                Padding="0"
                                Tag="{x:Bind}"
                                Tapped="OnRowTapped"
                                RightTapped="OnRowRightTapped"
                                PointerPressed="OnRowPointerPressed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="94" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Background="{StaticResource EhSubtleSurfaceBrush}" CornerRadius="5,0,0,5">
                                        <Grid>
                                            <FontIcon Glyph="&#xEB9F;" FontSize="22" Foreground="{StaticResource EhTextSecondaryBrush}" />
                                            <Border
                                                x:Name="ThumbHost"
                                                CornerRadius="5,0,0,5" />
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Column="1" Padding="14,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock
                                            Text="{x:Bind Title}"
                                            FontSize="14.5"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap"
                                            MaxLines="2"
                                            TextTrimming="CharacterEllipsis"
                                            Foreground="{StaticResource EhTextPrimaryBrush}" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Text="{x:Bind Uploader}"
                                            FontSize="12"
                                            Foreground="{StaticResource EhTextSecondaryBrush}"
                                            Margin="0,2,0,4" />

                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border
                                                Background="{x:Bind views:UiHelpers.CategoryBrush(Info.Category)}"
                                                CornerRadius="3"
                                                Padding="7,2">
                                                <TextBlock
                                                    Text="{x:Bind views:HistoryPage.CategoryNameOf(Info.Category)}"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Foreground="#FFFFFFFF" />
                                            </Border>
                                            <Border
                                                Background="{StaticResource EhSubtleSurfaceBrush}"
                                                CornerRadius="3"
                                                Padding="6,2">
                                                <TextBlock Text="{x:Bind ModeText}" FontSize="11" Foreground="{StaticResource EhPrimaryBrush}" />
                                            </Border>
                                            <TextBlock
                                                Text="{x:Bind TimeText}"
                                                FontSize="11.5"
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource EhTextSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0"
                                        Padding="8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Tag="{x:Bind Gid}"
                                        ToolTipService.ToolTip="移除此条历史"
                                        Click="OnDeleteRowClick">
                                        <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{StaticResource EhTextSecondaryBrush}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
