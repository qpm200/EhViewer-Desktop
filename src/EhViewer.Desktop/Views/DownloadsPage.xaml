<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EhViewer.Desktop.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EhViewer.Desktop.Controls"
    xmlns:dl="using:EhViewer.Desktop.Downloads"
    xmlns:vm="using:EhViewer.Desktop.ViewModels"
    xmlns:views="using:EhViewer.Desktop.Views"
    Background="{StaticResource EhPageBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:MaterialToolbar
            Title="下载管理与本地库"
            Subtitle="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            ShowRightDrawerButton="True"
            RightDrawerRequested="OnRightDrawerRequested">
            <controls:MaterialToolbar.RightActions>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button
                        Style="{StaticResource EhToolbarIconButtonStyle}"
                        ToolTipService.ToolTip="全部开始"
                        Click="OnStartAllClick">
                        <FontIcon Glyph="&#xE768;" FontSize="15" />
                    </Button>
                    <Button
                        Style="{StaticResource EhToolbarIconButtonStyle}"
                        ToolTipService.ToolTip="全部暂停"
                        Click="OnPauseAllClick">
                        <FontIcon Glyph="&#xE769;" FontSize="15" />
                    </Button>
                    <Button
                        Style="{StaticResource EhToolbarIconButtonStyle}"
                        ToolTipService.ToolTip="刷新"
                        Click="OnRefreshClick">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    </Button>
                    <Button
                        Style="{StaticResource EhToolbarIconButtonStyle}"
                        ToolTipService.ToolTip="更多管理与迁移工具">
                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="下载标签管理..." Icon="{x:Null}" Click="OnManageLabelsClick" />
                                <MenuFlyoutItem Text="导入压缩包到库..." Click="OnImportArchiveClick" />
                                <MenuFlyoutItem Text="从 Android 版迁移数据..." Click="OnMigrateAndroidClick" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="导出下载清单 CSV" Click="OnExportCsvClick" />
                                <MenuFlyoutItem Text="导入下载清单 CSV" Click="OnImportCsvClick" />
                                <MenuFlyoutItem Text="清理无效下载文件夹" Click="OnCleanInvalidClick" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="打开下载根目录" Click="OnOpenDirectoryClick" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </controls:MaterialToolbar.RightActions>
        </controls:MaterialToolbar>

        <!-- Filter, Search, Mode Switch & Path Card -->
        <Border
            Grid.Row="1"
            Background="{StaticResource EhCardSurfaceBrush}"
            BorderBrush="{StaticResource EhDividerBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,10">
            <StackPanel Spacing="10">
                <!-- Segment Tabs matching Android Queue / Local Library / Archiver -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="TabAllBtn" Style="{StaticResource EhTealPrimaryButtonStyle}" Padding="12,5" Content="全部视图" Click="OnSegmentAllClick" />
                        <Button x:Name="TabQueueBtn" Padding="12,5" Content="下载队列" Click="OnSegmentQueueClick" />
                        <Button x:Name="TabLocalBtn" Padding="12,5" Content="本地画廊库" Click="OnSegmentLocalClick" />
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        Margin="16,0"
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.DownloadRoot, Mode=OneWay}"
                        FontSize="11.5"
                        TextTrimming="CharacterEllipsis"
                        IsTextSelectionEnabled="True"
                        Foreground="{StaticResource EhTextSecondaryBrush}" />

                    <ToggleButton
                        Grid.Column="2"
                        Style="{StaticResource EhTealToggleButtonStyle}"
                        Content="批量多选"
                        IsChecked="{x:Bind ViewModel.IsMultiSelectMode, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        PlaceholderText="搜索下载标题、标签或 GID..."
                        Text="{x:Bind ViewModel.SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="136"
                        ItemsSource="{x:Bind ViewModel.LabelFilterOptions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedLabelFilter, Mode=TwoWay}" />
                    <ComboBox
                        Grid.Column="2"
                        MinWidth="128"
                        ItemsSource="{x:Bind ViewModel.StateFilterOptions}"
                        SelectedItem="{x:Bind ViewModel.SelectedStateFilter, Mode=TwoWay}" />
                    <ComboBox
                        Grid.Column="3"
                        MinWidth="136"
                        ItemsSource="{x:Bind ViewModel.LibrarySortOptions}"
                        SelectedIndex="{x:Bind ViewModel.SelectedLibrarySortIndex, Mode=TwoWay}" />
                </Grid>

                <!-- Batch Operations Bar -->
                <Border
                    Background="{StaticResource EhSubtleSurfaceBrush}"
                    CornerRadius="6"
                    Padding="10,6"
                    Visibility="{x:Bind views:UiHelpers.VisibleIf(ViewModel.IsMultiSelectMode), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            Text="{x:Bind FormatSelectedCount(ViewModel.SelectedCount), Mode=OneWay}"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource EhPrimaryBrush}" />
                        <Button Content="全选当前" Padding="10,4" Click="OnSelectAllClick" />
                        <Button Content="取消选择" Padding="10,4" Click="OnClearSelectionClick" />
                        <Button Content="分配标签" Style="{StaticResource EhTealPrimaryButtonStyle}" Padding="10,4" Click="OnBatchAssignLabelClick" />
                        <Button Content="批量删除" Padding="10,4" Click="OnBatchDeleteClick" />
                    </StackPanel>
                </Border>

                <InfoBar
                    Visibility="{x:Bind views:UiHelpers.VisibleIfNotEmpty(ViewModel.ErrorMessage), Mode=OneWay}"
                    IsOpen="{x:Bind HasText(ViewModel.ErrorMessage), Mode=OneWay}"
                    Severity="Error"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <!-- Main Download Content -->
        <ScrollViewer Grid.Row="2" Padding="16,12">
            <StackPanel Spacing="14">

                <!-- Download Queue Section -->
                <Border x:Name="QueueSectionCard" Style="{StaticResource EhMaterialCardStyle}" Padding="14,12">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="下载任务队列"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource EhTextPrimaryBrush}" />

                        <TextBlock
                            Text="当前没有下载任务或匹配筛选的队列条目。"
                            FontSize="12.5"
                            Padding="4,6"
                            Foreground="{StaticResource EhTextSecondaryBrush}"
                            Visibility="{x:Bind views:UiHelpers.VisibleWhenZero(ViewModel.ActiveRows.Count), Mode=OneWay}" />

                        <ListView
                            x:Name="QueueListView"
                            ItemsSource="{x:Bind ViewModel.ActiveRows, Mode=OneWay}"
                            SelectionMode="{x:Bind ToSelectionMode(ViewModel.IsMultiSelectMode), Mode=OneWay}"
                            SelectionChanged="OnQueueSelectionChanged"
                            MaxHeight="340">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DownloadRow">
                                    <Grid RowSpacing="5" ColumnSpacing="10" Padding="4,8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                Text="{x:Bind Title}"
                                                FontSize="13.5"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="{StaticResource EhTextPrimaryBrush}" />
                                            <TextBlock
                                                Text="{x:Bind Error}"
                                                FontSize="11.5"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Visibility="{x:Bind HasError}" />
                                        </StackPanel>

                                        <Border
                                            Grid.Column="1"
                                            CornerRadius="4"
                                            Padding="7,2"
                                            Background="{StaticResource EhTagBackgroundBrush}"
                                            BorderBrush="{StaticResource EhTagBorderBrush}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind LabelDisplay}" FontSize="11" Foreground="{StaticResource EhPrimaryBrush}" />
                                        </Border>

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind StateText}"
                                            FontSize="12"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource EhTextPrimaryBrush}" />

                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{x:Bind ProgressText}"
                                            FontSize="12"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource EhTextSecondaryBrush}" />

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
                                            <Button Content="暂停" FontSize="11.5" Padding="8,4" Tag="{x:Bind Gid}" Click="OnPauseClick" Visibility="{x:Bind CanPause}" />
                                            <Button Content="继续" FontSize="11.5" Padding="8,4" Tag="{x:Bind Gid}" Click="OnResumeClick" Visibility="{x:Bind CanResume}" />
                                            <Button Content="标签" FontSize="11.5" Padding="8,4" Tag="{x:Bind Gid}" Click="OnAssignLabelClick" />
                                            <Button Content="取消" FontSize="11.5" Padding="8,4" Tag="{x:Bind Gid}" Click="OnCancelClick" Visibility="{x:Bind CanCancel}" />
                                            <Button Content="删除" FontSize="11.5" Padding="8,4" Tag="{x:Bind Gid}" Click="OnDeleteRowClick" />
                                        </StackPanel>

                                        <ProgressBar
                                            Grid.Row="1"
                                            Grid.ColumnSpan="5"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="{x:Bind ProgressPercent}"
                                            IsIndeterminate="{x:Bind IsIndeterminate}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Archiver Queue Section -->
                <Border
                    x:Name="ArchiverSectionCard"
                    Style="{StaticResource EhMaterialCardStyle}"
                    Padding="14,12"
                    Visibility="{x:Bind HasAnyArchivers(ViewModel.ArchiverRows.Count), Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="Archiver 归档下载"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource EhTextPrimaryBrush}" />

                        <ListView ItemsSource="{x:Bind ViewModel.ArchiverRows, Mode=OneWay}" SelectionMode="None" MaxHeight="220">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="dl:ArchiverTaskSnapshot">
                                    <Grid RowSpacing="4" ColumnSpacing="10" Padding="4,6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" Foreground="{StaticResource EhTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ResolutionLabel}" FontSize="11.5" Foreground="{StaticResource EhTextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind StateDisplay}" FontSize="12" Foreground="{StaticResource EhTextPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind ProgressDisplay}" FontSize="12" Foreground="{StaticResource EhTextSecondaryBrush}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
                                            <Button Content="暂停" FontSize="11.5" Padding="8,4" Tag="{x:Bind TaskId}" Click="OnArchiverPauseClick" Visibility="{x:Bind CanPause}" />
                                            <Button Content="继续" FontSize="11.5" Padding="8,4" Tag="{x:Bind TaskId}" Click="OnArchiverResumeClick" Visibility="{x:Bind CanResume}" />
                                            <Button Content="取消" FontSize="11.5" Padding="8,4" Tag="{x:Bind TaskId}" Click="OnArchiverCancelClick" Visibility="{x:Bind IsActive}" />
                                            <Button Content="移除" FontSize="11.5" Padding="8,4" Tag="{x:Bind TaskId}" Click="OnArchiverRemoveClick" />
                                        </StackPanel>

                                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="5" Minimum="0" Maximum="100" Value="{x:Bind ProgressPercent}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Local Library Section -->
                <Border x:Name="LocalSectionCard" Style="{StaticResource EhMaterialCardStyle}" Padding="14,12">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="已下载本地画廊库"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource EhTextPrimaryBrush}" />

                        <TextBlock
                            Text="本地下载目录暂无已下载画廊。"
                            FontSize="12.5"
                            Padding="4,6"
                            Foreground="{StaticResource EhTextSecondaryBrush}"
                            Visibility="{x:Bind views:UiHelpers.VisibleWhenZero(ViewModel.LocalGalleries.Count), Mode=OneWay}" />

                        <ListView ItemsSource="{x:Bind ViewModel.LocalGalleries, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="dl:LocalGallery">
                                    <Grid
                                        ColumnSpacing="12"
                                        Padding="6,10"
                                        Tapped="OnLocalGalleryTapped"
                                        Background="Transparent">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="开始阅读" Click="OnLocalGalleryReadMenuClick" />
                                                <MenuFlyoutItem Text="在资源管理器中打开" Click="OnLocalGalleryOpenFolderMenuClick" />
                                                <MenuFlyoutItem Text="删除本地画廊" Click="OnLocalGalleryDeleteMenuClick" />
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="3">
                                            <TextBlock
                                                Text="{x:Bind Title}"
                                                FontSize="13.5"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="2"
                                                TextWrapping="Wrap"
                                                Foreground="{StaticResource EhTextPrimaryBrush}" />
                                            <TextBlock
                                                Text="{x:Bind DirectoryPath}"
                                                FontSize="11"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="1"
                                                IsTextSelectionEnabled="True"
                                                Foreground="{StaticResource EhTextSecondaryBrush}" />
                                        </StackPanel>

                                        <Border
                                            Grid.Column="1"
                                            Background="{StaticResource EhTagBackgroundBrush}"
                                            BorderBrush="{StaticResource EhTagBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="7,2"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind views:UiHelpers.VisibleIfNotEmpty(Label)}">
                                            <TextBlock Text="{x:Bind Label}" FontSize="11" Foreground="{StaticResource EhPrimaryBrush}" />
                                        </Border>

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind ImageCount}"
                                            FontSize="12"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource EhTextPrimaryBrush}" />

                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{x:Bind Pages}"
                                            FontSize="12"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource EhTextSecondaryBrush}" />

                                        <Button
                                            Grid.Column="4"
                                            Style="{StaticResource EhAccentFlatButtonStyle}"
                                            Padding="10,4"
                                            FontSize="12"
                                            Content="开始阅读"
                                            VerticalAlignment="Center"
                                            Click="OnLocalGalleryReadMenuClick" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
