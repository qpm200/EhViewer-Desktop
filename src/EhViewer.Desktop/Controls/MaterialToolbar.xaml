<UserControl
    x:Class="EhViewer.Desktop.Controls.MaterialToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Height="56"
        Background="{StaticResource EhToolbarSurfaceBrush}"
        BorderBrush="{StaticResource EhDividerBrush}"
        BorderThickness="0,0,0,1"
        Padding="8,0,12,0">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="BackBtn"
                Grid.Column="0"
                Style="{StaticResource EhToolbarIconButtonStyle}"
                Visibility="Collapsed"
                ToolTipService.ToolTip="返回 (Esc / Alt+←)"
                Click="OnBackClick">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                <TextBlock
                    x:Name="TitleText"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource EhToolbarForegroundBrush}"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1" />
                <TextBlock
                    x:Name="SubtitleText"
                    FontSize="11"
                    Foreground="{StaticResource EhToolbarSubtitleForegroundBrush}"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1"
                    Visibility="Collapsed" />
            </StackPanel>

            <ContentPresenter x:Name="ExtraActionsPresenter" Grid.Column="2" VerticalAlignment="Center" />

            <Button
                x:Name="RightDrawerBtn"
                Grid.Column="3"
                Style="{StaticResource EhToolbarIconButtonStyle}"
                Visibility="Collapsed"
                ToolTipService.ToolTip="打开右侧栏"
                Click="OnRightDrawerClick">
                <FontIcon Glyph="&#xE700;" FontSize="16" />
            </Button>
        </Grid>
    </Border>
</UserControl>
