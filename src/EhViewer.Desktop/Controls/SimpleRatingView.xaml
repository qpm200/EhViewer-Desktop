    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel x:Name="StarPanel" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
        <FontIcon x:Name="Star1" Glyph="&#xE734;" FontSize="12" Foreground="#FFFFC107" />
        <FontIcon x:Name="Star2" Glyph="&#xE734;" FontSize="12" Foreground="#FFFFC107" />
        <FontIcon x:Name="Star3" Glyph="&#xE734;" FontSize="12" Foreground="#FFFFC107" />
        <FontIcon x:Name="Star4" Glyph="&#xE734;" FontSize="12" Foreground="#FFFFC107" />
        <FontIcon x:Name="Star5" Glyph="&#xE734;" FontSize="12" Foreground="#FFFFC107" />
    </StackPanel>
</UserControl>
