<UserControl
    x:Class="EhViewer.Desktop.Controls.SearchLayoutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EhViewer.Desktop.Controls">

    <Grid x:Name="OverlayRoot" Visibility="Collapsed">
        <!-- Dimmed scrim matching Android SearchLayout background overlay -->
        <Border x:Name="SearchOverlayScrim" Background="{StaticResource EhScrimBrush}" PointerPressed="OnScrimPressed" />

        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Margin="16,68,16,24"
            MaxWidth="780"
            MaxHeight="680">
            <Border
                x:Name="SearchPanelCard"
                Style="{StaticResource EhFloatingCardStyle}"
                Padding="16"
                Translation="0,0,24">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <StackPanel Spacing="14">
                    <!-- Search Mode Tabs: Normal Search / Image Search -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ToggleButton
                            x:Name="NormalTabBtn"
                            Grid.Column="0"
                            Style="{StaticResource EhTealToggleButtonStyle}"
                            HorizontalAlignment="Stretch"
                            IsChecked="True"
                            Content="普通 / 高级搜索"
                            Click="OnTabNormalClick" />

                        <ToggleButton
                            x:Name="ImageTabBtn"
                            Grid.Column="1"
                            Style="{StaticResource EhTealToggleButtonStyle}"
                            HorizontalAlignment="Stretch"
                            IsChecked="False"
                            Content="以图搜图"
                            Click="OnTabImageClick" />

                        <Button
                            Grid.Column="2"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="关闭搜索面板 (Esc)"
                            Click="OnClosePanelClick">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                        </Button>
                    </Grid>

                    <!-- PANEL 1: Normal + Advance Search -->
                    <StackPanel x:Name="NormalPanel" Spacing="12">
                        <!-- Category 10-grid header & quick toggles -->
                        <Grid>
                            <TextBlock
                                Text="分类过滤 (点击开关)"
                                Style="{StaticResource EhSettingsCategoryTitleStyle}"
                                Margin="0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Button Content="全选" Style="{StaticResource EhAccentFlatButtonStyle}" Padding="8,2" Click="OnSelectAllCategoriesClick" />
                                <Button Content="清空" Style="{StaticResource EhAccentFlatButtonStyle}" Padding="8,2" Click="OnClearAllCategoriesClick" />
                            </StackPanel>
                        </Grid>

                        <!-- Exact Android 10-category color pills -->
                        <Grid x:Name="CategoryGrid" ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                        </Grid>

                        <Border Height="1" Background="{StaticResource EhDividerBrush}" />

                        <!-- 4 Android Search Modes + Advance Switch -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <controls:TagWrapPanel Grid.Column="0" HorizontalSpacing="14" VerticalSpacing="4">
                                <RadioButton x:Name="ModeNormalRadio" GroupName="SearchScopeMode" Content="普通搜索" IsChecked="True" />
                                <RadioButton x:Name="ModeSubscriptionRadio" GroupName="SearchScopeMode" Content="订阅标签" />
                                <RadioButton x:Name="ModeUploaderRadio" GroupName="SearchScopeMode" Content="指定上传者" />
                                <RadioButton x:Name="ModeTagRadio" GroupName="SearchScopeMode" Content="精确标签" />
                            </controls:TagWrapPanel>

                            <ToggleSwitch
                                x:Name="AdvanceToggle"
                                Grid.Column="1"
                                OnContent="高级选项: 开"
                                OffContent="高级选项: 关"
                                Toggled="OnAdvanceToggled" />
                        </Grid>

                        <!-- Collapsible AdvanceSearchTable -->
                        <Border
                            x:Name="AdvancePanel"
                            Visibility="Collapsed"
                            Background="{StaticResource EhSubtleSurfaceBrush}"
                            BorderBrush="{StaticResource EhCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="12" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <CheckBox x:Name="AdvSearchName" Grid.Row="0" Grid.Column="0" Content="搜索画廊名称" IsChecked="True" />
                                    <CheckBox x:Name="AdvSearchTags" Grid.Row="0" Grid.Column="1" Content="搜索画廊标签" IsChecked="True" />
                                    <CheckBox x:Name="AdvSearchDesc" Grid.Row="0" Grid.Column="2" Content="搜索画廊简介" />

                                    <CheckBox x:Name="AdvSearchTorr" Grid.Row="1" Grid.Column="0" Content="搜索种子文件名" />
                                    <CheckBox x:Name="AdvOnlyTorr" Grid.Row="1" Grid.Column="1" Content="仅显示有种子" />
                                    <CheckBox x:Name="AdvLowPower" Grid.Row="1" Grid.Column="2" Content="搜索低权重标签" />

                                    <CheckBox x:Name="AdvDownvoted" Grid.Row="2" Grid.Column="0" Content="搜索被踩标签" />
                                    <CheckBox x:Name="AdvExpunged" Grid.Row="2" Grid.Column="1" Content="显示已删除画廊" />
                                </Grid>

                                <controls:TagWrapPanel HorizontalSpacing="10" VerticalSpacing="8">
                                    <CheckBox x:Name="AdvMinRatingCheck" Content="最低评分" VerticalAlignment="Center" />
                                    <ComboBox x:Name="AdvMinRatingCombo" SelectedIndex="0" Width="104">
                                        <ComboBoxItem Content="2 ★" Tag="2" />
                                        <ComboBoxItem Content="3 ★" Tag="3" />
                                        <ComboBoxItem Content="4 ★" Tag="4" />
                                        <ComboBoxItem Content="5 ★" Tag="5" />
                                    </ComboBox>

                                    <CheckBox x:Name="AdvPagesCheck" Content="页数范围" VerticalAlignment="Center" />
                                    <TextBox x:Name="AdvPageFromBox" PlaceholderText="最小" Width="76" />
                                    <TextBlock Text="–" VerticalAlignment="Center" />
                                    <TextBox x:Name="AdvPageToBox" PlaceholderText="最大" Width="76" />
                                </controls:TagWrapPanel>

                                <controls:TagWrapPanel HorizontalSpacing="16" VerticalSpacing="6">
                                    <CheckBox x:Name="AdvDisableCustom" Content="禁用自定义过滤" />
                                    <CheckBox x:Name="AdvDisableDefault" Content="禁用默认标签屏蔽" />
                                    <CheckBox x:Name="AdvDisableLang" Content="禁用语言排除" />
                                </controls:TagWrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- PANEL 2: Image Search -->
                    <StackPanel x:Name="ImagePanel" Visibility="Collapsed" Spacing="12">
                        <Border
                            BorderBrush="{StaticResource EhDividerBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16"
                            Background="{StaticResource EhSubtleSurfaceBrush}">
                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                <Image
                                    x:Name="ImagePreview"
                                    MaxHeight="180"
                                    MaxWidth="320"
                                    Stretch="Uniform"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    x:Name="SelectedImagePathText"
                                    Text="尚未选择图片（支持 PNG / JPG / WebP，也可以直接拖放到窗口中）"
                                    Foreground="{StaticResource EhTextSecondaryBrush}"
                                    HorizontalAlignment="Center"
                                    TextWrapping="Wrap" />
                                <Button
                                    Content="选择本地图片..."
                                    Style="{StaticResource EhTealPrimaryButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Click="OnPickSearchImageClick" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
                            <CheckBox x:Name="ImgUssCheck" Content="使用相似度扫描" IsChecked="True" />
                            <CheckBox x:Name="ImgOscCheck" Content="仅搜索画廊封面" IsChecked="False" />
                            <CheckBox x:Name="ImgSeCheck" Content="显示已删除画廊" IsChecked="False" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Bottom Actions -->
                    <Border Height="1" Background="{StaticResource EhDividerBrush}" />
                    <Grid>
                        <Button
                            Content="保存为快速搜索"
                            Style="{StaticResource EhAccentFlatButtonStyle}"
                            HorizontalAlignment="Left"
                            Click="OnSaveQuickSearchClick" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="取消" Click="OnClosePanelClick" />
                            <Button
                                x:Name="SubmitSearchBtn"
                                Content="立即搜索"
                                Style="{StaticResource EhTealPrimaryButtonStyle}"
                                Click="OnSubmitSearchClick" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
