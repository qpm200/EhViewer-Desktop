<UserControl
    x:Class="EhViewer.Desktop.Controls.FabLayoutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <!-- Backdrop scrim only hit-tested when expanded -->
        <Border
            x:Name="ScrimBorder"
            Visibility="Collapsed"
            Background="{StaticResource EhScrimBrush}"
            PointerPressed="OnScrimPressed" />

        <StackPanel
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,24,24"
            Spacing="12">

            <!-- Expandable Secondary Mini-FABs (Android scene_gallery_list order) -->
            <StackPanel
                x:Name="MiniFabsPanel"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                Spacing="10">

                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Border Style="{StaticResource EhFloatingCardStyle}" Padding="10,5" VerticalAlignment="Center">
                        <TextBlock Text="标签过滤 (EhFilter)" FontSize="12" Foreground="{StaticResource EhTextPrimaryBrush}" />
                    </Border>
                    <Button Style="{StaticResource EhMiniFabButtonStyle}" ToolTipService.ToolTip="标签过滤规则" Click="OnFilterClick">
                        <FontIcon Glyph="&#xE71C;" FontSize="15" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Border Style="{StaticResource EhFloatingCardStyle}" Padding="10,5" VerticalAlignment="Center">
                        <TextBlock Text="页码 / 日期跳转" FontSize="12" Foreground="{StaticResource EhTextPrimaryBrush}" />
                    </Border>
                    <Button Style="{StaticResource EhMiniFabButtonStyle}" ToolTipService.ToolTip="跳页或按日期回溯" Click="OnGoToClick">
                        <FontIcon Glyph="&#xE787;" FontSize="15" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Border Style="{StaticResource EhFloatingCardStyle}" Padding="10,5" VerticalAlignment="Center">
                        <TextBlock Text="刷新当前列表" FontSize="12" Foreground="{StaticResource EhTextPrimaryBrush}" />
                    </Border>
                    <Button Style="{StaticResource EhMiniFabButtonStyle}" ToolTipService.ToolTip="刷新列表" Click="OnRefreshClick">
                        <FontIcon Glyph="&#xE72C;" FontSize="15" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Border Style="{StaticResource EhFloatingCardStyle}" Padding="10,5" VerticalAlignment="Center">
                        <TextBlock Text="随机打开一本" FontSize="12" Foreground="{StaticResource EhTextPrimaryBrush}" />
                    </Border>
                    <Button Style="{StaticResource EhMiniFabButtonStyle}" ToolTipService.ToolTip="随机打开当前列表中的画廊" Click="OnRandomClick">
                        <FontIcon Glyph="&#xE8B1;" FontSize="15" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Primary Circular Material FAB -->
            <Button
                x:Name="PrimaryFab"
                Style="{StaticResource EhFabButtonStyle}"
                HorizontalAlignment="Right"
                ToolTipService.ToolTip="快捷功能菜单"
                Click="OnPrimaryFabClick">
                <FontIcon
                    x:Name="PrimaryFabIcon"
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Glyph="&#xE710;"
                    FontSize="20" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
